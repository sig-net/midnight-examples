{
  "name": "@sig-net/midnight-examples",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Examples leveraging the Signature Network MPC technology to bring other chains to Midnight. Run `yarn compile` once before `build`/`test` — contract packages typecheck against their generated managed/ output.",
  "workspaces": [
    "packages/*",
    "examples/*/*"
  ],
  "scripts": {
    "compile": "yarn workspaces foreach --all --exclude @sig-net/midnight-examples --topological run compile",
    "compile:zk": "yarn workspaces foreach --all --exclude @sig-net/midnight-examples --topological run compile:zk",
    "compile:erc20-vault": "yarn workspace @sig-net/midnight-examples-erc20-vault-contract compile",
    "compile:erc20-vault:zk": "yarn workspace @sig-net/midnight-examples-erc20-vault-contract compile:zk",
    "deploy:erc20-vault": "yarn workspace @sig-net/midnight-examples-erc20-vault-deploy deploy",
    "deploy-initialize:erc20-vault": "yarn workspace @sig-net/midnight-examples-erc20-vault-deploy deploy-initialize",
    "initialize:erc20-vault": "yarn workspace @sig-net/midnight-examples-erc20-vault-deploy initialize",
    "test:erc20-vault": "yarn workspace @sig-net/midnight-examples-erc20-vault-contract test && yarn workspace @sig-net/midnight-examples-erc20-vault-client test && yarn workspace @sig-net/midnight-examples-erc20-vault-deploy test && yarn workspace @sig-net/midnight-examples-erc20-vault-integration-tests test",
    "test:erc20-vault:e2e": "yarn workspace @sig-net/midnight-examples-erc20-vault-integration-tests test:e2e",
    "build:erc20-vault": "yarn workspace @sig-net/midnight-examples-erc20-vault-contract build && yarn workspace @sig-net/midnight-examples-erc20-vault-client build && yarn workspace @sig-net/midnight-examples-erc20-vault-deploy build && yarn workspace @sig-net/midnight-examples-erc20-vault-integration-tests build",
    "benchmark:static:erc20-vault": "yarn workspace @sig-net/midnight-examples-erc20-vault-integration-tests benchmark:static",
    "benchmark:report:erc20-vault": "yarn workspace @sig-net/midnight-examples-erc20-vault-integration-tests benchmark:report",
    "build": "yarn workspaces foreach --all --exclude @sig-net/midnight-examples --topological run build",
    "test": "yarn workspaces foreach --all --exclude @sig-net/midnight-examples --topological run test",
    "lint": "eslint . --max-warnings=0 --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "resolutions": {
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.3",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-beta.2"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.26",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
