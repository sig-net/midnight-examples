{
  // Prettier formats, ESLint fixes. Never both formatting the same file:
  // eslint-config-prettier turns off every rule that would fight Prettier.
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // The type-aware pass builds a TypeScript program, so lint on save rather
  // than on every keystroke.
  "eslint.run": "onSave",

  // The repo's own pinned Prettier, never whatever the extension bundles: an
  // extension update formatting differently from `yarn format:check` would
  // redline CI on a diff the editor thinks is fine.
  "prettier.prettierPath": "./node_modules/prettier",

  "search.exclude": {
    "**/src/managed": true,
    "**/.yarn": true
  },

  // The formal analysis builds through the .latexmkrc beside it (xelatex,
  // then BibTeX), the same way CI and the README build it. The extension's
  // stock recipes pass their own engine flags, and its magic-comment path
  // runs a single engine pass with no bibliography, so both are bypassed.
  // Builds run only on request (Cmd+Alt+B): the committed main.pdf must not
  // be rewritten every time a dependency changes on disk.
  "latex-workshop.latex.recipe.default": "latexmk (latexmkrc)",
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.latex.autoBuild.run": "never"
}
