{
  "name": "@sig-net/midnight-examples-erc20-vault-integration-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Integration tests that drive the erc20-vault example in-process (src/flows/) against a running local stack. Env-gated: skips entirely unless RUN_INTEGRATION_TESTS is set.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "RUN_INTEGRATION_TESTS=1 vitest run --disable-console-intercept --bail 1",
    "read-state": "tsx scripts/read-state.ts",
    "benchmark:static": "tsx scripts/benchmark-static.ts",
    "benchmark:report": "tsx scripts/benchmark-report.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.18.0-rc.1",
    "@midnight-ntwrk/midnight-js": "5.0.0-beta.6",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-beta.6",
    "@sig-net/midnight": "0.21.0-rc.6",
    "@sig-net/midnight-contract-deploy": "0.21.0-rc.6",
    "@sig-net/midnight-examples-erc20-vault-contract": "workspace:*",
    "@sig-net/midnight-examples-erc20-vault-deploy": "workspace:*",
    "@sig-net/midnight-examples-lib": "workspace:*",
    "@sig-net/midnight-examples-test-harness": "workspace:*",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "compact-zkir-lint": "0.2.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
