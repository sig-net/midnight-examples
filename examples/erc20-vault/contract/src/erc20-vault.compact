//                                        ⚠️ CAUTION ⚠️
// This is an example application for educational and experimental purposes.
// Use at your own risk and expect rapid iteration.
//
// ==================== ERC20 Cross Chain Vault: Signet integration example ==============
// A Signet client contract that moves ERC20 value between an EVM chain and shielded
// tokens on the Midnight blockchain, with the Signet Distributed MPC network executing
// the EVM side.
//
// READ THIS FILE TOGETHER WITH THE EXAMPLE README (../../README.md). The README's
// integration walkthrough explains the protocol, the derived keys and accounts, and the
// off-chain runtime legs. The "Setup step N" / "Runtime step N" markers below mirror its
// numbering:
//
//   Setup step 2:               the Signet import.
//   Setup step 3:               the ledger state and the constructor.
//   Setup step 4:               initialize().
//   Runtime step 1 (deposit):   deposit().
//   Runtime step 5 (deposit):   claim().
//   Runtime step 1 (withdraw):  withdraw().
//   Runtime step 5 (withdraw):  completeWithdraw() / refund().
//
// Runtime steps 2 to 4 (polling the MPC's responses, broadcasting to the EVM chain) are
// off-chain client code: see the README walkthrough and ../../integration-tests/src/flows/.

pragma language_version >= 0.25;

import CompactStandardLibrary;

// Setup step 2: import the shared signet protocol module, resolved through node_modules
// via COMPACT_PATH (see the compile scripts in package.json).
import "@sig-net/midnight/src/Signet";

// ---- Setup step 3: signet ledger state ----------------------------------------------
// The three protocol-required fields every signet client contract declares, kept
// together: the event map, the Signet singleton reference, and the MPC response key.

// The request map the MPC reads authenticated SignBidirectionalEvents back from. Sized
// for an ERC20 transfer(address,uint256): <2 calldata words, 0 access-list entries,
// 0 storage keys>. Schema widths are 34 bytes, the exact length of
// vaultResponseSchema() (schemas are exact-width by protocol convention, never padded).
// This declaration is ledger FIELD 0, so its resolved ledger-tree path is [0] at
// depth 1 (this contract has 15 or fewer fields, so each field sits directly in the
// state tree's root array). The request circuits pack this path into their
// notifications, and the MPC follows it to locate the map. The compiled path is
// recorded as this field's "index" in managed/erc20-vault/compiler/contract-info.json.
// The map must stay first and never move after the first deploy. No other field's
// position carries meaning, so no other field is numbered.
export ledger signBidirectionalEventMap: SignBidirectionalEventMap<EvmType2TxParams<2, 0, 0>, 34, 34>;

// The Signet singleton, pinned at deploy. The request circuits cross-contract call it
// to emit the notification events the MPC polls.
sealed ledger signetSigner: SignetSigner;

// The MPC RESPONSE key for this contract, derived off-chain from the MPC root key +
// THIS contract's address + the fixed path "midnight response key". It never signs
// transactions: it is the key claim, completeWithdraw and refundWithdraw accept
// RespondBidirectionalEvents from, and their only authentication gate (the Signet
// singleton emits MPC posts unverified). It depends on the contract's own address, so
// it is set in initialize() (Setup step 4), not the constructor.
export ledger mpcResponseKey: Secp256k1Point;

// ---- Vault state --------------------------------------------------------------------

// Keeps otherwise identical requests hashing to distinct request ids.
export ledger signetRequestNonce: Counter;

// Becomes 1 once initialize() has run.
export ledger initialized: Counter;

// The vault's own EVM address (derivation path "vault"), the contract-enforced
// recipient of every deposit transfer. Derived FROM this contract's Midnight address,
// so it is set in initialize(), not the constructor.
export ledger vaultEvmAddress: Bytes<20>;

// The ONE EVM chain this vault operates on, as the numeric id (for the transactions
// the MPC signs) and the CAIP-2 string (for MPC routing). One vault serves one chain,
// so requests never take a chain argument. Two fields exist as Compact cannot render a
// number as a decimal string in-circuit: the deployer-gated initialize() is trusted to
// supply a consistent pair.
export ledger evmChainId: Uint<64>;
export ledger caip2Id: Bytes<32>;

// Identity commitment of the deployer. Only they may call initialize().
sealed ledger deployer: Bytes<32>;

// Pending withdrawals: requestId -> the withdrawer's refund commitment (see
// withdrawRefundCommitment), pinned at request time so ONLY the withdrawer can pull a
// refund when the EVM transfer fails. Doubles as the pending-withdrawal marker, and is
// the ONLY per-withdrawal state: the surrendered coin itself is burned at receive time
// (see withdraw), so any number of withdrawals across any ERC20 colours proceed
// concurrently.
export ledger refundCommitment: Map<RequestId, Bytes<32>>;

// ---- Swap state (Uniswap V3) --------------------------------------------------------
// The pinned Uniswap SwapRouter02: the ONLY spender approveRouter grants an allowance to,
// and the ONLY `to` a swap sends to. Pinned at initialize (like vaultEvmAddress), so a
// malicious client can never point the pooled funds at a fake router. Field index 10.
export ledger uniswapRouter: Bytes<20>;

// Swap requests. exactInputSingle is 7 calldata words with a uint256 (amountOut) result,
// so this is a SEPARATE map from signBidirectionalEventMap (field 0, sized for a 2-word
// transfer): the calldata width is part of the ledger type. This is ledger FIELD 11 (see
// the field-0 note on how positions are counted; sealed fields count). Swap's notification
// names this position, so like field 0 it must never move after the first deploy.
export ledger swapEventMap: SignBidirectionalEventMap<EvmType2TxParams<7, 0, 0>, 39, 39>;

// Pending-swap marker + swapper refund gate, mirroring refundCommitment for withdrawals
// (kept separate so a swap requestId can never be settled through a withdraw circuit).
export ledger swapRefundCommitment: Map<RequestId, Bytes<32>>;

// ---- Fixed MPC routing --------------------------------------------------------------
// This vault does exactly one thing: have the MPC sign ERC20 `transfer` calls on an EVM
// chain. The event fields that follow from that are contract CONSTANTS, never circuit
// arguments: algo is always ecdsa, dest always unused, params always blank, and both
// serialisation schemas are the schema below.

// The ABI-style JSON schema of an ERC20 `transfer` result, used in both directions: it
// tells the MPC how to deserialise the EVM execution output and how to serialise that
// output into the RespondBidirectionalEvent it posts back. Exact-width: 34 bytes.
// Exported so off-chain code reads the schema from the compiled circuit, never a TS
// re-declaration.
export pure circuit vaultResponseSchema(): Bytes<34> {
  return "[{\"name\":\"success\",\"type\":\"bool\"}]" as Bytes<34>;
}

// The decoded form of vaultResponseSchema()'s output: the ABI `bool success` of an
// ERC20 transfer, packed by the MPC to this struct's exact serialized width (1 byte).
// claim and completeWithdraw unpack the attested bytes back into it with the stdlib
// deserialize, the true inverse of the MPC's off-chain packing.
struct VaultResponse {
  success: Boolean;
}

// The result schema of Uniswap's exactInputSingle: a single uint256 amountOut. Exact
// width: 39 bytes. The MPC decodes the swap's return against it and serialises the packed
// amountOut (32 bytes) into the attestation completeSwap verifies.
pure circuit swapResponseSchema(): Bytes<39> {
  return "[{\"name\":\"amountOut\",\"type\":\"uint256\"}]" as Bytes<39>;
}

// ---- Token model --------------------------------------------------------------------
// Each ERC20 the vault handles gets its own shielded token colour: the domain separator
// encodes the ERC20 address, and tokenType() binds it to this contract via
// kernel.self(). claim mints under it, withdraw accepts only coins of it. Exported so
// off-chain code computes coin colours by calling the compiled circuit, never a TS
// re-implementation.
export pure circuit vaultTokenDomainSeparator(erc20Address: Bytes<20>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "erc20:vault:"),
    erc20Address as Field as Bytes<32>
  ]);
}

// ---- Identity -----------------------------------------------------------------------
// Users prove identity with a secret-key witness. Only a commitment (hash) of the key
// ever reaches the ledger, and it doubles as the MPC key-derivation path of deposit
// requests: identity -> path -> MPC-derived account is a forced 1:1 mapping (see the
// README's "Derived keys and accounts").

witness callerSecretKey(): Bytes<32>;

// Exported so off-chain code (deploy tooling, tests) computes commitments by calling
// the compiled circuit.
export pure circuit userCommitment(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "vault:user:"), sk]);
}

// The refund commitment withdraw pins and completeWithdraw's refund branch proves.
// Deliberately NOT userCommitment: the deposit path publishes THAT commitment on the
// ledger (as the request's derivation path), so reusing it would let anyone link a
// withdrawal's refund marker to a depositor's identity. The distinct domain string
// breaks that link, and binding the (already public) requestId makes every
// withdrawal's commitment unique, so two withdrawals by the same secret are unlinkable
// to each other too.
export pure circuit withdrawRefundCommitment(sk: Bytes<32>, requestId: RequestId): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "vault:refund:"),
    sk,
    requestId as Bytes<32>
  ]);
}

// ---- Setup step 3 (continued): the constructor --------------------------------------
// The constructor pins WHO may configure (the deployer's identity commitment, computed
// off-chain from their secret via the compiled userCommitment circuit) and the Signet
// singleton. Everything that needs the contract's own address waits for initialize().

constructor(
  deployerCommitment: Bytes<32>,
  signetContract: SignetSigner,
) {
  deployer = disclose(deployerCommitment);
  signetSigner = disclose(signetContract);
}

// ---- Setup step 4: initialize -------------------------------------------------------
// One-shot, deployer-gated post-deploy configuration. The vault's derived EVM address
// and the MPC response key both take this contract's address as derivation input, so
// they can only be derived (off-chain) once the address exists, right after deploy. The
// gate prevents front-running: nobody else can initialise the vault to point at their
// own address, chain or key.
export circuit initialize(
  vaultEvm: Bytes<20>,
  router: Bytes<20>,
  chainId: Uint<64>,
  chainCaip2Id: Bytes<32>,
  responseKey: Secp256k1Point
): [] {
  assert(initialized == 0, "Already initialized");
  assert(userCommitment(callerSecretKey()) == deployer, "Not the deployer");
  assert(chainId > 0 as Uint<64>, "Chain ID must be positive");
  assert(router as Field != 0 as Field, "Router cannot be zero");
  initialized.increment(1);
  vaultEvmAddress = disclose(vaultEvm);
  uniswapRouter = disclose(router);
  evmChainId = disclose(chainId);
  caip2Id = disclose(chainCaip2Id);
  mpcResponseKey = disclose(responseKey);
}

// ---- Runtime step 1 (deposit): deposit ----------------------------------------------

// The vault-specific arguments of a deposit. Everything else about the request is
// composed by the contract, see deposit.
struct DepositRequest {
  erc20Address: Bytes<20>; // the ERC20 token contract on the target chain
  amount: Uint<128>;       // token amount to move into the vault
}

// Records a SignBidirectionalEvent for `transfer(vaultEvmAddress, amount)` on the
// ERC20, to be signed by the MPC with the CALLER's derived account and broadcast
// off-chain (runtime steps 2 and 3). The contract composes the ENTIRE transaction and
// routing itself. The caller supplies only what is genuinely theirs to choose: their
// account's nonce, the gas envelope their account pays, and the MPC key version. The
// derivation path is not an argument at all: it is the caller's identity commitment,
// recomputed in-circuit, so the MPC signs with THIS caller's account and no one else's.
export circuit deposit(
  evmNonce: Uint<64>,
  gasLimit: Uint<64>,
  maxFeePerGas: Uint<128>,
  maxPriorityFeePerGas: Uint<128>,
  keyVersion: Uint<8>,
  depositRequest: DepositRequest
): [] {
  assert(initialized >= 1, "Not initialized");
  assert(depositRequest.erc20Address as Field != 0 as Field, "ERC20 address cannot be zero");
  assert(depositRequest.amount > 0 as Uint<128>, "Amount must be positive");
  // Claims mint shielded tokens via a Uint<64> API; reject unclaimable amounts.
  assert(depositRequest.amount <= 18446744073709551615 as Uint<128>, "Amount exceeds Uint<64> max");
  assert(gasLimit > 0 as Uint<64>, "Gas limit must be positive");

  // Identity -> derivation-path binding: claim later recomputes this commitment and
  // requires it to match the stored request's path, making claims depositor-only.
  const caller = disclose(userCommitment(callerSecretKey()));

  // Contract-enforced calldata: transfer(vaultEvmAddress, amount), built here and
  // never taken from the caller. The initialize-pinned recipient is what stops a
  // malicious client having the MPC sign a transfer to themselves. Words are
  // ABI-READY (big-endian, broadcast form): the signer concatenates
  // selector || words verbatim, so these bytes ARE the calldata.
  const calldata = EvmCalldata<2> {
    selector: Bytes [0xa9, 0x05, 0x9c, 0xbb], // transfer(address,uint256)
    noWords: 2 as Uint<16>,
    words: [
      evmAddressAbiWord(vaultEvmAddress),
      numericAbiWord(depositRequest.amount),
    ]
  };

  // The full transaction the MPC will sign: the deposit's ERC20 on the
  // initialize-pinned chain, no ETH value, the caller's gas envelope.
  const txParams = EvmType2TxParams<2, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: maxPriorityFeePerGas,
    maxFeePerGas: maxFeePerGas,
    gasLimit: gasLimit,
    to: depositRequest.erc20Address,
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<2>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };

  const schema = vaultResponseSchema();
  const requestNonce = signetRequestNonce as Uint<64>;
  const request = constructSignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34>(
    kernel.self(),
    requestNonce,
    keyVersion,
    caller,
    MPCSignatureAlgorithm.ecdsa,
    MPCDestination.unused,
    pad(64, ""),
    TxParamType.evmType2,
    txParams,
    caip2Id,
    schema,
    schema
  );
  // Circuit arguments are private inputs, and the event record is public ledger state
  // by design, so disclose it (and its id) explicitly at the write site.
  const requestId = disclose(calculateRequestId<EvmType2TxParams<2, 0, 0>, 34, 34>(request));

  assert(!signBidirectionalEventMap.member(requestId), "Request already exists");
  signetRequestNonce.increment(1);
  signBidirectionalEventMap.insert(requestId, disclose(request));

  // Notify the MPC via the Signet singleton's notification event. The path arguments
  // carry the resolved ledger-tree path of signBidirectionalEventMap: depth 1, path
  // [0], as the map is ledger field 0 (see its declaration).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(),
      1 as Uint<8>,
      [0, 0, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// ---- Runtime step 5 (deposit): claim ------------------------------------------------
// The caller presents the MPC's signature-only RespondBidirectionalEvent together with
// the full serialized output they recomputed off-chain (the event carries only the MPC's
// signature, never the digest or the output), and the vault mints shielded vault tokens
// for the deposited amount, to the caller or an optionally provided recipient.
// Depositor-gated, one claim per request. mintNonce must be RANDOM: a nonce derived
// from the (public) requestId would let any observer link the minted coin to the
// deposit.
export circuit claim(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<1>,
  mintNonce: Bytes<32>,
  recipient: Maybe<Either<ZswapCoinPublicKey, ContractAddress>>,
): [] {
  // requestId keys the ledger operations, so it is public. The response is only
  // verified, never written, and stays private.
  const disclosedRequestId = disclose(requestId);

  assert(initialized >= 1, "Not initialized");

  // The EVM result at its exact packed width (one byte, transfer()'s bool),
  // deserialized into the schema's struct: only an attested success mints.
  const response = deserialize<VaultResponse, 1>(serializedOutput);
  assert(response.success, "ERC20 transfer returned false");

  // The only authentication gate: the attestation digest is recomputed here from the
  // presented output, and the event's ECDSA signature over it must verify against the
  // initialize-pinned response key (the Signet singleton emits MPC posts unverified).
  assert(
    verifyRespondBidirectionalEvent<1>(
      disclosedRequestId,
      serializedOutput,
      disclose(respondBidirectionalEvent),
      mpcResponseKey
    ),
    "Invalid attestation signature"
  );

  // Double-claim protection: the request must exist and is consumed here.
  assert(signBidirectionalEventMap.member(disclosedRequestId), "Request not found");
  const signatureRequest = signBidirectionalEventMap.lookup(disclosedRequestId);
  signBidirectionalEventMap.remove(disclosedRequestId);

  // Depositor gate: the caller's recomputed commitment must match the request's
  // derivation path (deposit stored the depositor's commitment there).
  const caller = userCommitment(callerSecretKey());
  assert(caller == signatureRequest.path, "Not the depositor");

  // Mint for the deposited amount: deposit stored it as calldata word 1 (an ABI-ready
  // big-endian word) and the ERC20 address in txParams.to. The random mint nonce is
  // disclosed (a mint's nonce is public anyway) but never derivable from the request.
  assert(signatureRequest.txParams.calldata.is_some, "Request has no calldata");
  const amount = abiWordToUint128(signatureRequest.txParams.calldata.value.words[1]);
  const erc20Addr = signatureRequest.txParams.to;

  const domainSep = vaultTokenDomainSeparator(erc20Addr);
  const claimRecipient = disclose(recipient).is_some
    ? disclose(recipient).value
    : left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
  mintShieldedToken(domainSep, amount as Uint<64>, disclose(mintNonce), claimRecipient);
}

// ---- Runtime step 1 (withdraw): withdraw --------------------------------------------

// The vault-specific arguments of a withdraw. The surrendered coin is a separate
// (coin-typed) circuit parameter.
struct WithdrawRequest {
  erc20Address: Bytes<20>;   // the ERC20 token contract on the target chain
  amount: Uint<128>;         // token amount to pull out of the vault
  destEvmAddress: Bytes<20>; // EVM recipient of the vault's transfer
}

// Starts a withdrawal, optimistically: the caller surrenders `amount` of the ERC20's
// vault token up front, and the vault records a request for
// `transfer(destEvmAddress, amount)`, to be signed by the MPC with the VAULT's own
// derived account (path = the contract-fixed literal "vault"). Anyone may withdraw to
// any destination: the coin spend IS the authorisation, since the wallet funds it from
// the caller's own balance. On EVM failure completeWithdraw re-mints the surrendered
// value to the withdrawer, who proves the refund commitment pinned here.
//
// The VAULT's account pays the withdraw gas, so the entire fee envelope is
// contract-fixed below, never caller-chosen: a caller-supplied fee cap would let
// anyone burn the vault account's ETH at will.
export circuit withdraw(
  evmNonce: Uint<64>,
  keyVersion: Uint<8>,
  withdrawRequest: WithdrawRequest,
  coin: ShieldedCoinInfo
): [] {
  assert(initialized >= 1, "Not initialized");
  assert(withdrawRequest.erc20Address as Field != 0 as Field, "ERC20 address cannot be zero");
  assert(withdrawRequest.amount > 0 as Uint<128>, "Amount must be positive");
  // A refund re-mints via the same Uint<64> API claims use; reject unrefundable
  // amounts.
  assert(withdrawRequest.amount <= 18446744073709551615 as Uint<128>, "Amount exceeds Uint<64> max");

  // The coin must be the vault token for THIS erc20, of exactly `amount`.
  const color = tokenType(
    vaultTokenDomainSeparator(disclose(withdrawRequest.erc20Address)),
    kernel.self()
  );
  assert(coin.color == color, "Coin is not the vault token for this ERC20");
  assert(coin.value == withdrawRequest.amount, "Coin value must equal the withdraw amount");

  // Contract-enforced calldata: transfer(destEvmAddress, amount). The destination is a
  // validated typed argument, bound into the request id below. Words are ABI-READY
  // (big-endian, broadcast form), used verbatim by the signer.
  const calldata = EvmCalldata<2> {
    selector: Bytes [0xa9, 0x05, 0x9c, 0xbb], // transfer(address,uint256)
    noWords: 2 as Uint<16>,
    words: [
      evmAddressAbiWord(withdrawRequest.destEvmAddress),
      numericAbiWord(withdrawRequest.amount),
    ]
  };

  // Contract-FIXED gas envelope: an ERC20 transfer costs ~50-65k gas, so the caps are
  // generous for a testnet. Retuning them means a redeploy, the price of keeping the
  // vault's ETH out of callers' hands.
  const txParams = EvmType2TxParams<2, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: 1000000000 as Uint<128>, // 1 gwei
    maxFeePerGas: 30000000000 as Uint<128>,       // 30 gwei
    gasLimit: 100000 as Uint<64>,
    to: withdrawRequest.erc20Address,
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<2>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };

  // Construct and key the event under the vault's OWN derivation path.
  const path = pad(32, "vault");
  const schema = vaultResponseSchema();
  const requestNonce = signetRequestNonce as Uint<64>;
  const request = constructSignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34>(
    kernel.self(),
    requestNonce,
    keyVersion,
    path,
    MPCSignatureAlgorithm.ecdsa,
    MPCDestination.unused,
    pad(64, ""),
    TxParamType.evmType2,
    txParams,
    caip2Id,
    schema,
    schema
  );
  // Circuit arguments are private inputs, and the event record is public ledger state
  // by design, so disclose it (and its id) explicitly at the write site.
  const requestId = disclose(calculateRequestId<EvmType2TxParams<2, 0, 0>, 34, 34>(request));
  assert(!signBidirectionalEventMap.member(requestId), "Request already exists");

  // The surrendered value is BURNED here: the receive obliges the transaction to pay
  // the coin to this contract, and the contract deliberately never records it, so it
  // can never be spent. Vault tokens are IOUs, and a refund MINTS fresh ones. No
  // per-withdrawal escrow slot means any number of concurrent withdrawals.
  receiveShielded(disclose(coin));

  // Record the event and pin the withdrawer's refund commitment: only the commitment
  // (a hash) reaches the ledger, the refund recipient's key stays private.
  signetRequestNonce.increment(1);
  signBidirectionalEventMap.insert(requestId, disclose(request));
  refundCommitment.insert(requestId, disclose(withdrawRefundCommitment(callerSecretKey(), requestId)));

  // Notify the MPC (ledger-tree path [0] at depth 1 = signBidirectionalEventMap, see
  // its declaration).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(),
      1 as Uint<8>,
      [0, 0, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// ---- Runtime step 5 (withdraw): the shared refund block -----------------------------
// The withdrawer gate plus re-mint bookkeeping both refund paths share. Deliberately
// NOT exported: completeWithdraw's false-return branch and refundWithdraw call it after
// their own width-specific verification, and nothing here re-checks that verification,
// so it must never be callable on its own. Withdrawer-only: a refund mints a private
// coin, so the caller must prove the secret behind the commitment pinned at withdraw
// time. Amount and token come from the consumed request: calldata word 1 and
// txParams.to. mintNonce must be RANDOM (see the callers).
circuit refundSurrenderedValue(
  disclosedRequestId: RequestId,
  signatureRequest: SignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34>,
  mintNonce: Bytes<32>
): [] {
  assert(
    withdrawRefundCommitment(callerSecretKey(), disclosedRequestId)
      == refundCommitment.lookup(disclosedRequestId),
    "Not the withdrawer"
  );

  // Re-mint the surrendered value to the withdrawer's own wallet key.
  assert(signatureRequest.txParams.calldata.is_some, "Request has no calldata");
  const amount = abiWordToUint128(signatureRequest.txParams.calldata.value.words[1]);
  const erc20Addr = signatureRequest.txParams.to;

  const domainSep = vaultTokenDomainSeparator(erc20Addr);
  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
  mintShieldedToken(domainSep, amount as Uint<64>, disclose(mintNonce), recipient);
}

// ---- Runtime step 5 (withdraw): completeWithdraw ------------------------------------
// Settles an EXECUTED withdrawal in both branches, decided by the MPC-attested output,
// never the caller. The transfer ran on the EVM, so its packed bool result is one byte:
// 0x01 (success) or 0x00 (the ERC20 returned false). On success the withdrawal is
// final (the surrendered value stays burned) and the call only cleans up: no mint, no
// identity, so ANYONE holding the attested success may settle it. On a false return
// the value re-mints to the WITHDRAWER only: they prove the secret behind the
// commitment pinned at withdraw time, under a caller-chosen random mintNonce (one
// derived from the public requestId would link the refunded coin to the withdrawal).
// One settle per request. A withdrawal whose transaction never executed (reverted or
// replaced) settles through refundWithdraw instead: the MPC attests the fixed 5-byte
// failure output, which cannot type-fit this circuit's Bytes<1>.
export circuit completeWithdraw(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<1>,
  mintNonce: Bytes<32>,
): [] {
  // requestId keys the ledger operations, so it is public. The response is only
  // verified, never written.
  const disclosedRequestId = disclose(requestId);

  assert(initialized >= 1, "Not initialized");

  // Same authentication gate as claim: the digest is recomputed from the presented
  // output, and the event's ECDSA signature over it must verify against the
  // initialize-pinned response key.
  assert(
    verifyRespondBidirectionalEvent<1>(
      disclosedRequestId,
      serializedOutput,
      disclose(respondBidirectionalEvent),
      mpcResponseKey
    ),
    "Invalid attestation signature"
  );

  // Double-settle protection: refundCommitment is the pending-withdrawal marker.
  // Deposits never insert it, so a deposit request cannot be settled through this
  // circuit (its own settle is claim, which is depositor-gated).
  assert(refundCommitment.member(disclosedRequestId), "Withdrawal not found");
  const signatureRequest = signBidirectionalEventMap.lookup(disclosedRequestId);
  signBidirectionalEventMap.remove(disclosedRequestId);

  // Branch on the EVM result, deserialized into the schema's struct (0x01 is
  // success, 0x00 a false return). Disclosed: whether a refund happens is
  // public anyway (a mint is observable).
  const succeeded = disclose(deserialize<VaultResponse, 1>(serializedOutput).success);

  if (!succeeded) {
    // Refund path only: it mints a private coin, so it is withdrawer-only (the shared
    // block proves the withdraw-time commitment). The success branch above skips all
    // of this, as cleanup needs no identity.
    refundSurrenderedValue(disclosedRequestId, signatureRequest, mintNonce);
  }

  refundCommitment.remove(disclosedRequestId);
}

// ---- Runtime step 5 (withdraw/swap): refund -----------------------------------------
// Settles a withdrawal OR a swap whose transaction NEVER EXECUTED: it reverted on-chain
// or its nonce was consumed by a replacement, so the MPC attested the protocol's fixed
// failure output (the 4-byte 0xdeadbeef sentinel plus one 0x01 byte, schema-independent
// and 5 bytes for every request, see MPC_FAILURE_OUTPUT in @sig-net/midnight). The
// distinct Bytes<5> width is what routes here: an executed transfer/swap's result can
// only settle through completeWithdraw/completeSwap. Both refund shapes share this exact
// signature (same Bytes<5> failure output), so they are ONE circuit that routes on which
// pending marker holds the id — merged to stay under the deploy block limit. One settle
// per request.
export circuit refund(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<5>,
  mintNonce: Bytes<32>,
): [] {
  // requestId keys the ledger operations, so it is public. The response is only
  // verified, never written.
  const disclosedRequestId = disclose(requestId);

  assert(initialized >= 1, "Not initialized");

  // Same authentication gate as claim: the digest is recomputed from the presented
  // output, and the event's ECDSA signature over it must verify against the
  // initialize-pinned response key.
  assert(
    verifyRespondBidirectionalEvent<5>(
      disclosedRequestId,
      serializedOutput,
      disclose(respondBidirectionalEvent),
      mpcResponseKey
    ),
    "Invalid attestation signature"
  );

  // Only the MPC's exact failure output refunds. Any other attested 5-byte output
  // (there are none today, but widths may collide as schemas grow) is not a failure.
  const failureOutput = Bytes [0xde, 0xad, 0xbe, 0xef, 0x01];
  assert(serializedOutput == failureOutput, "Not the MPC failure output");

  // Route by which pending marker holds the id: withdrawals and swaps use SEPARATE maps
  // (different calldata widths), so exactly one matches. The marker is public ledger
  // state, so the branch condition is public.
  if (disclose(refundCommitment.member(disclosedRequestId))) {
    // Withdrawal refund: withdrawer-only, re-minting the surrendered value under a
    // caller-chosen random mintNonce (completeWithdraw's failure branch verbatim).
    const signatureRequest = signBidirectionalEventMap.lookup(disclosedRequestId);
    signBidirectionalEventMap.remove(disclosedRequestId);
    refundSurrenderedValue(disclosedRequestId, signatureRequest, mintNonce);
    refundCommitment.remove(disclosedRequestId);
  } else {
    // Swap refund: swapper-only, re-minting the surrendered amountIn of tokenIn.
    assert(swapRefundCommitment.member(disclosedRequestId), "Request not found");
    const signatureRequest = swapEventMap.lookup(disclosedRequestId);
    swapEventMap.remove(disclosedRequestId);
    assert(
      withdrawRefundCommitment(callerSecretKey(), disclosedRequestId)
        == swapRefundCommitment.lookup(disclosedRequestId),
      "Not the swapper"
    );
    swapRefundCommitment.remove(disclosedRequestId);

    // Re-mint amountIn (calldata word 4) of tokenIn (word 0, low 20 bytes) to the swapper.
    assert(signatureRequest.txParams.calldata.is_some, "Request has no calldata");
    const amountIn = abiWordToUint128(signatureRequest.txParams.calldata.value.words[4]);
    const tokenIn = slice<20>(signatureRequest.txParams.calldata.value.words[0], 12);
    const domainSep = vaultTokenDomainSeparator(tokenIn);
    const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
    mintShieldedToken(domainSep, amountIn as Uint<64>, disclose(mintNonce), recipient);
  }
}

// ---- Swap: approveRouter ------------------------------------------------------------
// Permissionless, one-time-per-token router allowance. Records approve(uniswapRouter,
// ~unlimited) on the ERC20, signed by the MPC with the VAULT's account (the pooled funds
// live there) and broadcast off-chain. Spender is the initialize-pinned router and amount
// is contract-fixed, so the caller chooses ONLY the token: nobody can approve an arbitrary
// spender or drain the pool. Sign-only — nothing is minted and a stale/failed allowance
// just makes the next swap revert and refund — so there is NO settle circuit and this
// request entry is deliberately never consumed. The allowance is global per token (one
// pooled account), so the first caller readies a token for everyone; the frontend reads
// allowance() to know whether this leg is needed.
export circuit approveRouter(
  erc20Address: Bytes<20>,
  evmNonce: Uint<64>,
  keyVersion: Uint<8>
): [] {
  assert(initialized >= 1, "Not initialized");
  assert(erc20Address as Field != 0 as Field, "ERC20 address cannot be zero");

  // approve(uniswapRouter, 2^128-1). The amount is effectively unlimited (far above any
  // token supply), so one approve per token suffices forever.
  const calldata = EvmCalldata<2> {
    selector: Bytes [0x09, 0x5e, 0xa7, 0xb3], // approve(address,uint256)
    noWords: 2 as Uint<16>,
    words: [
      evmAddressAbiWord(uniswapRouter),
      numericAbiWord(340282366920938463463374607431768211455 as Uint<128>),
    ]
  };

  const txParams = EvmType2TxParams<2, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: 1000000000 as Uint<128>, // 1 gwei
    maxFeePerGas: 30000000000 as Uint<128>,        // 30 gwei
    gasLimit: 100000 as Uint<64>,
    to: disclose(erc20Address),                    // approve is called ON the ERC20
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<2>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };

  // Signed by the VAULT account: it holds the funds and is the token owner granting the
  // allowance. Same 2-word map + bool schema as a transfer, so it reuses field 0.
  const path = pad(32, "vault");
  const schema = vaultResponseSchema();
  const requestNonce = signetRequestNonce as Uint<64>;
  const request = constructSignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34>(
    kernel.self(),
    requestNonce,
    keyVersion,
    path,
    MPCSignatureAlgorithm.ecdsa,
    MPCDestination.unused,
    pad(64, ""),
    TxParamType.evmType2,
    txParams,
    caip2Id,
    schema,
    schema
  );
  const requestId = disclose(calculateRequestId<EvmType2TxParams<2, 0, 0>, 34, 34>(request));
  assert(!signBidirectionalEventMap.member(requestId), "Request already exists");
  signetRequestNonce.increment(1);
  signBidirectionalEventMap.insert(requestId, disclose(request));

  // Notify the MPC (ledger-tree path [0] at depth 1 = signBidirectionalEventMap). The
  // client polls the SignatureRespondedEvent and broadcasts; no attestation is consumed.
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(),
      1 as Uint<8>,
      [0, 0, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// ---- Swap: swap ---------------------------------------------------------------------
// The vault-specific arguments of a swap. The surrendered coin (tokenIn value) is a
// separate coin-typed parameter, as in withdraw.
struct SwapRequest {
  tokenIn: Bytes<20>;       // ERC20 sold (its vault coin is surrendered)
  tokenOut: Bytes<20>;      // ERC20 bought (its vault coin is minted on success)
  fee: Uint<24>;            // Uniswap V3 pool fee tier (e.g. 500, 3000)
  amountIn: Uint<128>;      // exact input amount
  amountOutMin: Uint<128>;  // on-chain slippage floor (router reverts below it)
}

// Starts a swap, optimistically (like withdraw): the caller surrenders `amountIn` of the
// tokenIn vault coin, and the vault records exactInputSingle on the pinned router, to be
// signed with the VAULT's account and broadcast off-chain. The router pulls tokenIn from
// the vault (via the approveRouter allowance) and sends tokenOut BACK to the vault
// (recipient is contract-pinned), keeping pool balance == shielded supply per token. On
// success completeSwap mints the attested amountOut of tokenOut; on EVM failure refundSwap
// re-mints the surrendered tokenIn. The coin spend IS the authorisation.
export circuit swap(
  evmNonce: Uint<64>,
  keyVersion: Uint<8>,
  swapRequest: SwapRequest,
  coin: ShieldedCoinInfo
): [] {
  assert(initialized >= 1, "Not initialized");
  assert(swapRequest.tokenIn as Field != 0 as Field, "tokenIn cannot be zero");
  assert(swapRequest.tokenOut as Field != 0 as Field, "tokenOut cannot be zero");
  assert(swapRequest.amountIn > 0 as Uint<128>, "amountIn must be positive");
  // A refund re-mints via the Uint<64> mint API; reject unrefundable inputs.
  assert(swapRequest.amountIn <= 18446744073709551615 as Uint<128>, "amountIn exceeds Uint<64> max");

  // The surrendered coin must be the vault token for tokenIn, of exactly amountIn.
  const color = tokenType(
    vaultTokenDomainSeparator(disclose(swapRequest.tokenIn)),
    kernel.self()
  );
  assert(coin.color == color, "Coin is not the vault token for tokenIn");
  assert(coin.value == swapRequest.amountIn, "Coin value must equal amountIn");

  // exactInputSingle((tokenIn, tokenOut, fee, recipient=vault, amountIn, amountOutMin, 0)).
  // recipient is the vault EVM address so bought tokens return to the pool; sqrtPriceLimit
  // is 0 (no price bound); slippage is enforced on-chain by amountOutMin (revert->refund).
  const calldata = EvmCalldata<7> {
    selector: Bytes [0x04, 0xe4, 0x5a, 0xaf], // exactInputSingle((address,address,uint24,address,uint256,uint256,uint160))
    noWords: 7 as Uint<16>,
    words: [
      evmAddressAbiWord(disclose(swapRequest.tokenIn)),
      evmAddressAbiWord(disclose(swapRequest.tokenOut)),
      numericAbiWord(swapRequest.fee as Uint<128>),
      evmAddressAbiWord(vaultEvmAddress),
      numericAbiWord(swapRequest.amountIn),
      numericAbiWord(swapRequest.amountOutMin),
      numericAbiWord(0 as Uint<128>),
    ]
  };

  // Contract-FIXED gas envelope (vault pays): a V3 single-hop swap is ~120-200k gas.
  const txParams = EvmType2TxParams<7, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: 1000000000 as Uint<128>, // 1 gwei
    maxFeePerGas: 30000000000 as Uint<128>,        // 30 gwei
    gasLimit: 300000 as Uint<64>,
    to: uniswapRouter,
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<7>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };

  const path = pad(32, "vault");
  const schema = swapResponseSchema();
  const requestNonce = signetRequestNonce as Uint<64>;
  const request = constructSignBidirectionalEvent<EvmType2TxParams<7, 0, 0>, 39, 39>(
    kernel.self(),
    requestNonce,
    keyVersion,
    path,
    MPCSignatureAlgorithm.ecdsa,
    MPCDestination.unused,
    pad(64, ""),
    TxParamType.evmType2,
    txParams,
    caip2Id,
    schema,
    schema
  );
  const requestId = disclose(calculateRequestId<EvmType2TxParams<7, 0, 0>, 39, 39>(request));
  assert(!swapEventMap.member(requestId), "Request already exists");

  // Burn the surrendered tokenIn value (see withdraw): received, never recorded.
  receiveShielded(disclose(coin));

  signetRequestNonce.increment(1);
  swapEventMap.insert(requestId, disclose(request));
  swapRefundCommitment.insert(requestId, disclose(withdrawRefundCommitment(callerSecretKey(), requestId)));

  // Notify the MPC (ledger-tree path [11] at depth 1 = swapEventMap).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(),
      1 as Uint<8>,
      [11, 0, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// ---- Swap: completeSwap -------------------------------------------------------------
// Settles a SUCCESSFUL swap: exactInputSingle either returns amountOut (>= amountOutMin,
// the router enforces the floor) or reverts, so a Bytes<32> attested output means success
// and carries the packed uint256 amountOut. Mints that amountOut of the tokenOut vault
// coin to the swapper. Swapper-gated (it mints a private coin), one settle per request.
// A swap whose transaction never executed settles through refundSwap: the MPC's fixed
// 5-byte failure output cannot type-fit this circuit's Bytes<32>.
export circuit completeSwap(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<32>,
  mintNonce: Bytes<32>,
): [] {
  const disclosedRequestId = disclose(requestId);

  assert(initialized >= 1, "Not initialized");

  // Same authentication gate as claim/completeWithdraw: recomputed output hashes to the
  // attested digest, and the in-circuit ECDSA verifies against the pinned response key.
  assert(
    verifyRespondBidirectionalEvent<32>(
      disclosedRequestId,
      serializedOutput,
      disclose(respondBidirectionalEvent),
      mpcResponseKey
    ),
    "Invalid attestation signature"
  );

  // Double-settle protection: swapRefundCommitment is the pending-swap marker (withdraw's
  // refundCommitment is separate, so a withdrawal cannot be settled here and vice versa).
  assert(swapRefundCommitment.member(disclosedRequestId), "Swap not found");
  const signatureRequest = swapEventMap.lookup(disclosedRequestId);
  swapEventMap.remove(disclosedRequestId);

  // Swapper gate: minting tokenOut to the swapper, so prove the swap-time commitment.
  assert(
    withdrawRefundCommitment(callerSecretKey(), disclosedRequestId)
      == swapRefundCommitment.lookup(disclosedRequestId),
    "Not the swapper"
  );
  swapRefundCommitment.remove(disclosedRequestId);

  // Mint the attested amountOut of the tokenOut vault coin. amountOut is the packed uint256
  // output (an ABI word); tokenOut is calldata word 1, its low 20 bytes the address. The
  // output is a circuit argument (witness), and a mint amount is public ledger state, so
  // disclose it — safe, as the swap's amountOut is already public (attested EVM result).
  // The attested amountOut is MIDNIGHT-NATIVE serialized: little-endian (low byte first),
  // unlike the big-endian ABI CALLDATA words abiWordToUint128 reads. Read the low 16 bytes
  // LE (Bytes as Field is little-endian) and require the high 16 bytes zero — the same
  // Uint<128> overflow guard abiWordToUint128 makes, mirrored for the little-endian output.
  assert(slice<16>(serializedOutput, 16) as Field == 0 as Field, "amountOut exceeds Uint<128>");
  const amountOut = disclose(slice<16>(serializedOutput, 0) as Field as Uint<128>);
  assert(amountOut <= 18446744073709551615 as Uint<128>, "amountOut exceeds Uint<64> max");
  assert(signatureRequest.txParams.calldata.is_some, "Request has no calldata");
  const tokenOut = slice<20>(signatureRequest.txParams.calldata.value.words[1], 12);
  const domainSep = vaultTokenDomainSeparator(tokenOut);
  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
  mintShieldedToken(domainSep, amountOut as Uint<64>, disclose(mintNonce), recipient);
}
