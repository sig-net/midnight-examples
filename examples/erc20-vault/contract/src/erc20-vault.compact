//                                        ⚠️ CAUTION ⚠️
// This is an example application for educational and experimental purposes.
// Use at your own risk and expect rapid iteration.
//
// ERC20 Cross-Chain Vault: a Signet client contract that moves ERC20 value between an
// EVM chain and shielded tokens on Midnight, with the Signet Distributed MPC network
// executing the EVM side. See ../../README.md for the full integration walkthrough.

pragma language_version >= 0.25;

import CompactStandardLibrary;

// Resolved through node_modules via COMPACT_PATH (see the compile scripts in package.json).
import "@sig-net/midnight/src/Signet";

// ---- Ledger state -------------------------------------------------------------------

// Approve and withdraw requests (2-word ERC20 transfer, 34-byte schemas).
// Compiled path for MPC notification: [0, 0] (read from managed/erc20-vault/compiler/contract-info.json).
export ledger signBidirectionalEventMap: SignBidirectionalEventMap<EvmType2TxParams<2, 0, 0>, 34, 34>;

// The Signet singleton the request circuits cross-contract call to notify the MPC.
sealed ledger signetSigner: SignetSigner;

// Verifies every attestation (the Signet singleton emits MPC posts unverified).
export ledger mpcResponseKey: Secp256k1Point;

// RETAINED, NOT READ. No circuit reads or increments this counter any more,
// and it stays at 0 forever.
//
// It existed to keep otherwise identical requests hashing to DISTINCT request
// ids, back when the vault's EVM transaction nonce was CALLER-supplied and two
// callers could name the same one. The vault EVM nonce is now assigned by the
// contract (see vaultEvmNonce), and it is part of every vault-signed request's
// txParams, which the request id hashes. Every vault-signed transaction comes
// from ONE EVM account, and Ethereum spends each of that account's nonces
// once, so the EVM nonce ALREADY makes each request id unique and there is
// nothing left for a second counter to disambiguate. The vault-signed flows
// pass the constant vaultSignedRequestNonce() instead.
//
// The FIELD stays because two things depend on a Counter sitting at ledger
// path [0,3], neither of them this contract:
//   - it is one of the SIX pinned paths. Deleting it would shrink chunk 0,
//     move chunk 1's base up by one and take every event-map path with it
//     (see the CAUTION below and tests/ledger-paths.test.ts).
//   - VAULT_NONCE_PATH exports that path for the SDK's raw request-ledger
//     reader, readSignetRequestsLedgerFromState, which throws unless the path
//     holds a Uint<64> Cell.
// So it is here to hold its position and to answer that reader, not because
// the contract needs it. Removing it is a path-moving change and belongs in
// its own commit.
export ledger signetRequestNonce: Counter;

// ---- Gas parameters of VAULT-SIGNED transactions ------------------------------------
//
// These govern every transaction the VAULT itself signs: approveStata, approveRouter,
// startWithdraw, startSwap, startSupply, startRedeem. They deliberately do NOT govern
// startDeposit, whose transaction is signed by the USER's own derived EVM account and
// paid out of it, so its envelope stays a caller argument.
//
// WHY LEDGER STATE AND NOT LITERALS.
// maxFeePerGas is a CEILING, not a price. Under EIP-1559 the sender pays base fee plus
// tip and is refunded everything below the cap, so a generous cap costs nothing while
// the market is calm — it is only ever paid during the spike it exists to survive. A
// cap set too low therefore buys no savings at all; it just makes transactions
// UNINCLUDABLE the moment the base fee crosses it. And because the vault signs against
// one sequential EVM nonce, one stalled transaction blocks every transaction queued
// behind it, so an unincludable cap is a whole-vault stall, not a slow request. The
// 30 gwei literals these replace did exactly that above 30 gwei of base fee.
// setGasParams() lets the deployer move them as the fee market moves.
//
// The gas LIMIT is a property of the operation, not of the market, so it is per kind;
// the fee cap and tip track the market, so they are global.
//
// DECLARED HERE (immediately after signetRequestNonce) ON PURPOSE, for the reason
// spelled out over depositRequestNonces below: the compiler puts the LAST 15 ledger
// fields in chunk 1, so APPENDING these at the end would re-chunk the state tree and
// move the pinned MPC notification paths. Inserting fields here pushes the chunk-1
// base down by the same count, so every chunk-1 offset — [1,3] [1,7] [1,11] [1,13] —
// and [0,0] and [0,3] above are all unchanged. tests/ledger-paths.test.ts is the
// tripwire that fails if that ever stops being true.
//
// THE FIVE PER-KIND LIMITS ARE ONE STRUCT CELL, NOT FIVE FIELDS, and that is a
// LAYOUT constraint, not a style choice. The compiler packs 15 fields per node, so
// two chunks hold 30. Field 31 does not extend chunk 1, it opens a THIRD chunk and
// the compiler re-splits from the top — chunk 0 keeps one field and everything else
// slides one chunk along — which moves all six paths the MPC pins at once. And it
// does that SILENTLY: the contract still compiles, the circuits still prove, and the
// off-chain signer simply stops seeing requests with no error anywhere. Five separate
// limit fields would have sat the vault at 29 of those 30, one slot from the edge.
// The five limits are only ever WRITTEN together, by initialise and setGasParams, and
// only ever READ one at a time, by the circuit that needs its own kind, so
// co-locating them costs nothing and buys four slots of headroom against that
// ceiling. They are still five values, one per kind, just in one cell. Anything added
// here in future spends headroom; past it, group rather than append.
export ledger vaultMaxFeePerGas: Uint<128>;
export ledger vaultMaxPriorityFeePerGas: Uint<128>;

// The gas limit of each kind of vault-signed transaction. One value per kind because
// the limit is a property of the operation; one CELL because of the field budget above.
struct VaultGasLimits {
  withdraw: Uint<64>;
  approve: Uint<64>;
  swap: Uint<64>;
  supply: Uint<64>;
  redeem: Uint<64>;
}
export ledger vaultGasLimits: VaultGasLimits;

// Becomes 1 once initialise() has run.
export ledger initialised: Counter;

// The vault's own EVM address (derivation path "vault"), the enforced deposit recipient.
export ledger vaultEvmAddress: Bytes<20>;

// The ONE EVM chain this vault operates on: initialise() supplies a consistent pair.
export ledger evmChainId: Uint<64>;
export ledger caip2Id: Bytes<32>;

// Identity commitment of the deployer. Only they may call initialise().
sealed ledger deployer: Bytes<32>;

// Per-caller deposit request nonces, keyed by the caller's identity commitment
// (startDeposit's `caller`). startDeposit sources its requestNonce from this
// caller's own slot instead of the single global signetRequestNonce, so two
// DIFFERENT callers' deposits no longer read one shared ledger cell and can
// both apply against the same proving state. The counter stays
// contract-controlled and monotonic per caller, so a caller still cannot replay
// their own settled request. Only deposit binds the caller into the request id
// (path = caller), so only deposit can safely key uniqueness on the caller; the
// vault-signed flows (approve*, withdraw, swap, supply, redeem) sign with the
// constant path "vault" and take their uniqueness from the contract-assigned
// vaultEvmNonce instead.
//
// Declared HERE (immediately before depositEventMap), not appended at the end,
// on purpose. The compiler chunks this 25-field state as [chunk 0: the first 10
// fields], [chunk 1: the last 15 fields], so the event maps below pin compiled
// paths the MPC notifications and src/index.ts depend on ([1,3], [1,7], [1,11],
// [1,13]). Inserting the new field just before depositEventMap shifts each of
// those fields one slot later AND the chunk-1 base one slot later too, so their
// offsets — and every pinned path — are unchanged.
//
// And there is a hard CEILING: two chunks hold 30 fields, 15 each. Field 31
// opens a third chunk and re-splits the whole tree, which breaks all six pinned
// paths at once however carefully the field was placed. At 25 the vault has
// five slots left; past that, group related values into one struct cell the way
// vaultGasLimits does rather than adding a field.
export ledger depositRequestNonces: Map<Bytes<32>, Counter>;

// The vault EVM account's next transaction nonce, assigned by `flush` alone.
//
// All four vault-signed flows (withdraw, swap, supply, redeem) plus
// approveStata/approveRouter sign from ONE shared EVM account (path =
// pad(32, "vault")). An EVM account's nonce is a single sequence, so if two
// callers each picked their own value only ONE of the two transactions could
// ever mine: the loser is attested as a failure and has to refund. That made
// the caller-supplied nonce an end-to-end throughput bottleneck, so start*
// no longer takes one and `flush` hands out the next value per drained entry.
//
// CONTIGUITY: Ethereum executes an account's transactions in nonce order, so
// a transaction at nonce 7 cannot mine until 5 and 6 have. This counter
// therefore advances by the number of entries ACTUALLY PROCESSED (see
// `flush`), never by the batch width, and a skipped slot consumes nothing.
//
// It is ALSO the whole of a vault-signed request's UNIQUENESS. The nonce sits
// in txParams, which the request id hashes, and one account spends each of its
// nonces once — so two byte-identical withdrawals drained in the same batch
// hash to different ids on their EVM nonces alone. That is why the separate
// request-id counter is gone: see signetRequestNonce, retained only for its
// pinned ledger path.
//
// Why the contract may own this at all: the vault EVM account can only be
// signed by a contract call, so the contract knows exactly how many
// signatures it has issued and no outside transaction can consume a nonce
// behind its back. A gap can only arise if a signed transaction is never
// broadcast, and that is self-healing: the signature is public (the singleton
// emits it in its SignatureRespondedEvent) and the request parameters are
// public in this contract's ledger map, so ANYONE can reconstruct the signed
// transaction and broadcast it to clear the gap. Hence no trust in the
// flusher, and no caller-supplied base, is needed.
//
// Declared HERE, before depositEventMap, for the chunking reason
// depositRequestNonces spells out above: the last 15 fields land in chunk 1,
// so a field added before depositEventMap grows chunk 0 and moves chunk 1's
// base by the same one slot, leaving [0,0], [0,3], [1,3], [1,7], [1,11] and
// [1,13] unchanged.
export ledger vaultEvmNonce: Counter;

// The kind tag of a queued vault-signed request, telling `flush` which EVM
// transaction to rebuild, which event map to record it in and which settle view
// to pin. Deposits are NOT queued: they carry a per-caller counter (see
// depositRequestNonces) and still emit from startDeposit.
export enum PendingRequestKind { withdraw, swap, supply, redeem }

// One queued vault-signed request: everything `flush` needs to rebuild the EVM
// transaction that startWithdraw/startSwap/startSupply/startRedeem used to
// build inline. The fields are the UNION of the four flows' inputs, so one
// queue serves all four; the per-kind meaning of each is beside it. The EVM
// nonce is deliberately NOT here: it belongs to the shared vault account, so
// flush assigns it at drain time from vaultEvmNonce.
struct PendingVaultRequest {
  kind: PendingRequestKind;
  keyVersion: Uint<8>;   // MPC key version; start validates it so flush cannot trap an entry
  tokenA: Bytes<20>;     // withdraw: the ERC20; swap: tokenIn; supply/redeem: unused
  tokenB: Bytes<20>;     // withdraw: destEvmAddress; swap: tokenOut; supply/redeem: unused
  fee: Uint<24>;         // swap: the pool fee tier; other kinds: 0
  amountA: Uint<128>;    // withdraw: amount; swap: amountOut; supply: amount; redeem: shares
  amountB: Uint<128>;    // swap: amountInMaximum; other kinds: 0
  coinNonce: Bytes<32>;  // the surrendered coin's nonce: the settle view's refund binder
}

// The pending queue the four VAULT-SIGNED flows append to.
//
// Those flows used to read a shared global counter inside start*, and that
// read is pinned by a popeq: two requests proven against the same state could
// not both apply. They now validate, burn the coin and APPEND here. `flush`
// (bottom of this file, callable by anyone) is the only circuit that touches a
// shared counter, and it hands out one distinct vaultEvmNonce per queued entry
// it drains. The shared read is out of the per-user path.
//
// KEY: refundCommitment(callerSecretKey(), coin.nonce) — the caller's secret
// bound to the nonce of the ONE coin each of these flows surrenders. Two
// different callers cannot collide (different secrets under a
// collision-resistant hash) and one caller cannot collide with themselves (a
// coin is spendable once, so its nonce appears in one request). Nothing about
// the key is derivable from public state, so a front-runner cannot squat a
// victim's slot and strand their burned coin. Making REQUESTS unique is not
// this key's job: the flush-assigned EVM nonce still does that. The key
// doubles as the settle view's refund commitment, which is why start can pin
// an ownership gate for a request id that does not exist yet.
//
// Declared HERE (immediately before depositEventMap), not appended at the end,
// for the reason depositRequestNonces above spells out: the compiler puts the
// LAST 15 fields of this state in chunk 1, so a field added before
// depositEventMap grows chunk 0 and moves chunk 1's base by the same one slot.
// [0,0], [0,3], [1,3], [1,7], [1,11] and [1,13] are therefore unchanged
// (re-checked in managed/erc20-vault/compiler/contract-info.json after
// compiling).
export ledger pendingVaultRequests: Map<Bytes<32>, PendingVaultRequest>;

// Deposit requests (2-word ERC20 transfer, 34-byte schemas).
// Compiled path for MPC notification: [1, 3] (read from managed/erc20-vault/compiler/contract-info.json).
export ledger depositEventMap: SignBidirectionalEventMap<EvmType2TxParams<2, 0, 0>, 34, 34>;

// depositSettleViews:
// Map of pending deposit requestIds against the depositor commitment that gates them,
// plus the erc20 and amount completeDeposit mints. Keeping the amount as Uint<64> prevents
// having to decode amounts from ABI words in the SignBidirectionalEvent signature request
// in the completeDeposit circuit.
struct DepositSettleView {
  commitment: Bytes<32>;
  erc20: Bytes<20>;
  amount: Uint<64>;
}
export ledger depositSettleViews: Map<RequestId, DepositSettleView>;

// withdrawSettleViews:
// Map of pending withdrawal requestIds against the refund commitment that gates them,
// plus the erc20 and amount they settle. Keeping the amount as Uint<64> prevents having
// to decode amounts from ABI words in the SignBidirectionalEvent signature request
// in the completeWithdraw or refundWithdraw circuits.
struct WithdrawSettleView {
  commitment: Bytes<32>;
  coinNonce: Bytes<32>; // refund binder: commitment == refundCommitment(sk, coinNonce)
  erc20: Bytes<20>;
  amount: Uint<64>;
}
export ledger withdrawSettleViews: Map<RequestId, WithdrawSettleView>;

// The pinned Uniswap SwapRouter02: the only approveRouter spender and swap `to`.
export ledger uniswapRouter: Bytes<20>;

// Swap requests (exactOutputSingle: 7 words, uint256 result repacked to uint64).
// Compiled path for MPC notification: [1, 7] (read from managed/erc20-vault/compiler/contract-info.json).
export ledger swapEventMap: SignBidirectionalEventMap<EvmType2TxParams<7, 0, 0>, 38, 37>;

// swapSettleViews:
// Map of pending swap requestIds against a view of their settlement amounts.
// Keeping a view of the settlement amounts as Uint<64> prevents having to
// decode amounts from ABI words in the SignBidirectionalEvent signature request
// in the completeSwap or refundSwap circuits.
struct SwapSettleView {
  commitment: Bytes<32>;
  coinNonce: Bytes<32>; // refund binder: commitment == refundCommitment(sk, coinNonce)
  tokenIn: Bytes<20>;
  tokenOut: Bytes<20>;
  amountOut: Uint<64>;
  amountInMaximum: Uint<64>;
}
export ledger swapSettleViews: Map<RequestId, SwapSettleView>;

// The pinned Aave USDC pair: underlying ERC20 + its ERC-4626 wrapper (stataUSDC).
export ledger stataUnderlying: Bytes<20>;
export ledger stataToken: Bytes<20>;

// Supply requests (stataToken.deposit(assets, receiver): 2 words, uint256 -> uint64).
// Compiled path for MPC notification: [1, 11] (read from managed/erc20-vault/compiler/contract-info.json).
export ledger supplyEventMap: SignBidirectionalEventMap<EvmType2TxParams<2, 0, 0>, 36, 35>;

// supplySettleViews:
// Map of pending supply requestIds against a view of their settlement amounts for use
// in the completeSupply or refundSupply circuits.
struct SupplySettleView {
  commitment: Bytes<32>;
  coinNonce: Bytes<32>; // refund binder: commitment == refundCommitment(sk, coinNonce)
  amount: Uint<64>;
}
export ledger supplySettleViews: Map<RequestId, SupplySettleView>;

// Redeem requests (stataToken.redeem(shares, receiver, owner): 3 words, uint256 -> uint64).
// Compiled path for MPC notification: [1, 13] (read from managed/erc20-vault/compiler/contract-info.json).
export ledger redeemEventMap: SignBidirectionalEventMap<EvmType2TxParams<3, 0, 0>, 36, 35>;

// redeemSettleViews:
// Map of pending redeem requestIds against a view of their settlement amounts for use
// in the completeRedeem or refundRedeem circuits.
struct RedeemSettleView {
  commitment: Bytes<32>;
  coinNonce: Bytes<32>; // refund binder: commitment == refundCommitment(sk, coinNonce)
  shares: Uint<64>;
}
export ledger redeemSettleViews: Map<RequestId, RedeemSettleView>;

// ---- Shared helpers -----------------------------------------------------------------
// Exported pure circuits exist so off-chain code reads these values from the compiled
// circuit, never a TS re-declaration.

// The ERC20 transfer result schema, used in both directions (output and respond).
export pure circuit vaultResponseSchema(): Bytes<34> {
  return "[{\"name\":\"success\",\"type\":\"bool\"}]" as Bytes<34>;
}

// vaultResponseSchema()'s output decoded: transfer()'s bool, packed by the MPC to 1 byte.
struct VaultResponse {
  success: Boolean;
}

// The requestNonce every VAULT-SIGNED request carries: a CONSTANT, not a
// counter. The request id hashes the whole record, txParams included, and
// txParams holds the vault EVM account's transaction nonce, which this
// contract assigns and Ethereum spends once per account. So the EVM nonce
// alone already separates two otherwise identical requests, and a second
// counter would only be repeating work. Exported so off-chain code reading
// the same records reads the value from the compiled circuit rather than
// re-declaring it. See signetRequestNonce for what this replaced.
export pure circuit vaultSignedRequestNonce(): Uint<64> {
  return 0;
}

// The allowance both approve circuits grant: 2^128-1, so one approve per spender
// suffices forever.
export pure circuit unlimitedAllowance(): Uint<128> {
  return 340282366920938463463374607431768211455;
}

// Each ERC20 gets its own shielded token colour. transientHash is pinned by the
// chain's ledger era: coins minted before a fork that changes it need a migration.
export pure circuit vaultTokenDomainSeparator(erc20Address: Bytes<20>): Bytes<32> {
  return upgradeFromTransient(transientHash<Vector<2, Bytes<32>>>([
    pad(32, "erc20:vault:"),
    erc20Address as Field as Bytes<32>
  ]));
}

witness callerSecretKey(): Bytes<32>;

// Identity commitment, doubling as the MPC key-derivation path of deposit requests. A
// transientHash change at a fork re-keys derived accounts and orphans pinned commitments.
export pure circuit userCommitment(sk: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<Vector<2, Bytes<32>>>([pad(32, "vault:user:"), sk]));
}

// Pinned into settle views and proven by requester gates. Deliberately NOT
// userCommitment (reuse would link settle views to depositor identities). The
// binder is whatever value pins the commitment to ONE request: the four
// vault-signed flows queue BEFORE their request id exists (see
// pendingVaultRequests), so they bind to the nonce of the coin they surrender,
// and the same value is their queue key. Before a fork that changes
// transientHash, every pending request must be settled or refunded.
export pure circuit refundCommitment(sk: Bytes<32>, binder: Bytes<32>): Bytes<32> {
  return upgradeFromTransient(transientHash<Vector<3, Bytes<32>>>([
    pad(32, "vault:refund:"),
    sk,
    binder
  ]));
}

// The gate every refund circuit runs first: the fixed 5-byte failure output
// (MPC_FAILURE_OUTPUT) is attested only for a transaction that NEVER EXECUTED, and its
// width routes it here (an executed result only type-fits its complete* circuit).
circuit assertAttestedFailureOutput(
  disclosedRequestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<5>
): [] {
  assert(initialised >= 1, "Not initialised");
  assert(
    verifyRespondBidirectionalEvent<5>(
      disclosedRequestId,
      serializedOutput,
      disclose(respondBidirectionalEvent),
      mpcResponseKey
    ),
    "Invalid attestation signature"
  );
  const failureOutput = Bytes [0xde, 0xad, 0xbe, 0xef, 0x01];
  assert(serializedOutput == failureOutput, "Not the MPC failure output");
}

// Pins WHO may configure. Everything needing the contract's own address waits for
// initialise().
constructor(
  deployerCommitment: Bytes<32>,
  signetContract: SignetSigner,
) {
  deployer = disclose(deployerCommitment);
  signetSigner = disclose(signetContract);
}

// ==== Initialisation and configuration ===============================================

// One-shot, deployer-gated post-deploy configuration: the derived values need the
// contract's own address, and the gate stops front-running the configuration.
export circuit initialise(
  vaultEvm: Bytes<20>,
  swapRouter: Bytes<20>,
  stataUnderlyingAddr: Bytes<20>,
  stataTokenAddr: Bytes<20>,
  chainId: Uint<64>,
  chainCaip2Id: Bytes<32>,
  responseKey: Secp256k1Point
): [] {
  assert(initialised == 0, "Already initialised");
  assert(userCommitment(callerSecretKey()) == deployer, "Not the deployer");
  assert(chainId > 0 as Uint<64>, "Chain ID must be positive");
  assert(swapRouter as Field != 0 as Field, "Router cannot be zero");
  assert(stataUnderlyingAddr as Field != 0 as Field, "stataUnderlying cannot be zero");
  assert(stataTokenAddr as Field != 0 as Field, "stataToken cannot be zero");
  initialised.increment(1);
  vaultEvmAddress = disclose(vaultEvm);
  uniswapRouter = disclose(swapRouter);
  stataUnderlying = disclose(stataUnderlyingAddr);
  stataToken = disclose(stataTokenAddr);
  evmChainId = disclose(chainId);
  caip2Id = disclose(chainCaip2Id);
  mpcResponseKey = disclose(responseKey);

  // The fee ceiling of every vault-signed transaction: 150 gwei. This is the MOST
  // the vault will pay per unit of gas, not what it pays. EIP-1559 charges base fee
  // plus tip and never the ceiling, so the ceiling decides only whether a
  // transaction can be included at all. The vault's own account pays this gas, so
  // the ceiling is the operator's exposure and the operator sets it.
  //
  // 150 sits just above the highest base fee of the last year: L1 runs at
  // single-digit gwei day to day and spikes a little past 100 during major
  // launches. It bounds the worst case at 0.105 ETH for the 700k-gas swap and
  // 0.015 ETH for the 100k-gas kinds.
  //
  // A ceiling set too low is not a saving, it is an outage: nothing the vault signs
  // can be included, and one stuck transaction blocks every later one because the
  // account has a single nonce sequence. Base fee rises at most 12.5% per block, so
  // a climb from single digits to 150 takes ~29 blocks, roughly six minutes. That
  // is the window to raise this through setGasParams().
  vaultMaxFeePerGas = 150000000000 as Uint<128>;   // 150 gwei
  // The tip is paid in FULL and never refunded, so it is the half worth keeping
  // tight. 1 gwei is already generous post-Dencun, and setGasParams() can raise it
  // when a spike makes inclusion genuinely competitive.
  vaultMaxPriorityFeePerGas = 1000000000 as Uint<128>; // 1 gwei

  // Per-kind gas limits, carried over from the literals they replace: a plain ERC20
  // approve/transfer, a Uniswap V3 exactOutputSingle, and Aave supply/redeem through
  // the ERC-4626 wrapper.
  vaultGasLimits = VaultGasLimits {
    withdraw: 100000 as Uint<64>,
    approve: 100000 as Uint<64>,
    swap: 700000 as Uint<64>,
    supply: 500000 as Uint<64>,
    redeem: 500000 as Uint<64>
  };
}

// Deployer-gated update of the gas envelope every VAULT-SIGNED transaction carries.
// Repeatable, unlike the one-shot initialise: initialise pins identities and addresses,
// which must never move, whereas the fee market moves constantly and a cap that cannot
// follow it is the stall this whole mechanism exists to prevent. The gate is
// initialise's exactly: the caller proves the deployer's identity commitment from the
// callerSecretKey witness.
//
// Does not touch startDeposit, which takes its gas envelope from its caller.
export circuit setGasParams(
  newMaxFeePerGas: Uint<128>,
  newMaxPriorityFeePerGas: Uint<128>,
  newWithdrawGasLimit: Uint<64>,
  newApproveGasLimit: Uint<64>,
  newSwapGasLimit: Uint<64>,
  newSupplyGasLimit: Uint<64>,
  newRedeemGasLimit: Uint<64>
): [] {
  assert(initialised >= 1, "Not initialised");
  assert(userCommitment(callerSecretKey()) == deployer, "Not the deployer");

  assert(newMaxFeePerGas > 0 as Uint<128>, "maxFeePerGas must be positive");
  // EIP-1559 rejects a transaction whose tip exceeds its cap, so a pair that would
  // make every vault transaction invalid must not reach the ledger.
  assert(
    newMaxPriorityFeePerGas <= newMaxFeePerGas,
    "maxPriorityFeePerGas cannot exceed maxFeePerGas"
  );
  // A zero gas limit is an instant out-of-gas on every kind it applies to.
  assert(newWithdrawGasLimit > 0 as Uint<64>, "Gas limit must be positive");
  assert(newApproveGasLimit > 0 as Uint<64>, "Gas limit must be positive");
  assert(newSwapGasLimit > 0 as Uint<64>, "Gas limit must be positive");
  assert(newSupplyGasLimit > 0 as Uint<64>, "Gas limit must be positive");
  assert(newRedeemGasLimit > 0 as Uint<64>, "Gas limit must be positive");

  vaultMaxFeePerGas = disclose(newMaxFeePerGas);
  vaultMaxPriorityFeePerGas = disclose(newMaxPriorityFeePerGas);
  // Written as ONE cell, exactly as initialise writes it: the five limits move
  // together or not at all, which is what lets them share a slot.
  vaultGasLimits = VaultGasLimits {
    withdraw: disclose(newWithdrawGasLimit),
    approve: disclose(newApproveGasLimit),
    swap: disclose(newSwapGasLimit),
    supply: disclose(newSupplyGasLimit),
    redeem: disclose(newRedeemGasLimit)
  };
}

// Break-glass: replace whatever the vault signed at `evmNonce` with an empty
// self-transfer, so a transaction that can never be included stops blocking the
// queue behind it.
//
// WHY REPLACEMENT AND NOT A HIGHER CEILING. The vault signs from ONE EVM account
// with a single sequential nonce, so a transaction that cannot be included blocks
// every later one. Raising the ceiling with setGasParams does NOT rescue a
// transaction already signed under the old one: the old maxFeePerGas is baked into
// the signed bytes and the signature covers it, so the old transaction sits in the
// mempool forever exactly as signed. The only Ethereum remedy is REPLACEMENT: send
// another transaction at the SAME nonce paying meaningfully more, which evicts the
// stuck one. An empty self-transfer — to the vault itself, zero value, no calldata,
// the 21000 gas an EVM value transfer with no calldata costs exactly — is the
// minimal form of that.
//
// ORDERING. Raise the fee values with setGasParams FIRST, then call this. A
// replacement must pay meaningfully more than what it replaces (nodes typically
// demand about 10% more on BOTH fee fields before they will evict the original),
// and this circuit takes its fees from the ledger, so calling it before the raise
// re-sends the same fees the stuck transaction already carries and the node drops
// the replacement.
//
// CONSEQUENCE, PLAINLY. This CANCELS whatever was at that nonce; it does not retry
// it. The original request's record stays in the event map unsettled and its
// operation — the approve, withdraw, swap, supply or redeem it was — does not
// happen. This is a break-glass for unblocking the queue at the cost of ONE
// request, not a retry mechanism. Whoever owned the cancelled request must start it
// again at a later nonce.
//
// NOT REPEATABLE AT THE SAME NONCE AND THE SAME FEES, and that is the intended
// behaviour. Like every vault-signed flow this now carries the constant
// vaultSignedRequestNonce(), so the id is a hash of (this nonce, these fees, this
// key version) and the duplicate-id assert below rejects a second call that
// changes none of them. Nothing is lost by that. A replacement only evicts the
// stuck transaction if it pays meaningfully more, so a genuine retry MUST come
// after a setGasParams raise and mints a different id anyway; and a byte-identical
// re-request would only re-derive a signature that already exists and is already
// public in the singleton's SignatureRespondedEvent, so anyone can simply
// rebroadcast the first one. The assert turns a useless second call into an error
// instead of a second signature over identical bytes.
//
// Unlike the queued flows, this circuit's EVM nonce is NAMED BY THE CALLER rather
// than drawn from vaultEvmNonce — naming the stuck value is the entire point — so
// it is the one vault-signed circuit whose uniqueness does not come from the
// contract's own counter.
//
// Records into the EXISTING signBidirectionalEventMap (calldata capacity 2, unused
// here) rather than a map of its own: a new ledger field would re-chunk the state
// tree and move the six compiled paths the MPC notifications pin.
export circuit adminReplaceEvmNonce(
  evmNonce: Uint<64>,
  keyVersion: Uint<8>
): [] {
  assert(initialised >= 1, "Not initialised");
  assert(userCommitment(callerSecretKey()) == deployer, "Not the deployer");

  const txParams = EvmType2TxParams<2, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,                                // the caller names the stuck nonce
    maxPriorityFeePerGas: vaultMaxPriorityFeePerGas,
    maxFeePerGas: vaultMaxFeePerGas,
    gasLimit: 21000 as Uint<64>,                    // exact cost of a value transfer with no calldata
    to: vaultEvmAddress,                            // the vault sends to ITSELF
    value: 0 as Uint<128>,
    calldata: none<EvmCalldata<2>>(),               // no calldata: the whole point of a replacement
    accessListEntryCount: 0,
    accessList: []
  };

  const path = pad(32, "vault");
  const schema = vaultResponseSchema();
  const requestNonce = vaultSignedRequestNonce();
  const request = constructSignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34>(
    kernel.self(),
    requestNonce,
    keyVersion,
    path,
    MPCSignatureAlgorithm.ecdsa,
    MPCDestination.unused,
    pad(64, ""),
    TxParamType.evmType2,
    txParams,
    caip2Id,
    schema,
    schema
  );
  const requestId = disclose(calculateRequestId<EvmType2TxParams<2, 0, 0>, 34, 34>(request));
  assert(!signBidirectionalEventMap.member(requestId), "Request already exists");
  signBidirectionalEventMap.insert(requestId, disclose(request));

  // Notify the MPC (signBidirectionalEventMap's compiled ledger path, [0,0]).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(),
      2 as Uint<8>,
      [0, 0, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// One-time MPC-signed approve(stataToken, unlimitedAllowance()) on the underlying
// USDC, so the wrapper can pull it during a supply. Signed with the VAULT account.
export circuit approveStata(
  keyVersion: Uint<8>
): [] {
  assert(initialised >= 1, "Not initialised");

  // Same shared account as the queued flows, so the SAME contract-owned nonce
  // sequence: see vaultEvmNonce. Read and consumed here rather than supplied
  // by the caller, or an approve would burn a value flush had already handed
  // out (or leave a gap that stalls every later vault transaction).
  const evmNonce = vaultEvmNonce as Uint<64>;
  vaultEvmNonce.increment(1);

  const calldata = EvmCalldata<2> {
    selector: Bytes [0x09, 0x5e, 0xa7, 0xb3], // approve(address,uint256)
    noWords: 2 as Uint<16>,
    words: [
      evmAddressAbiWord(stataToken),
      numericAbiWord(unlimitedAllowance()),
    ]
  };
  const txParams = EvmType2TxParams<2, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: vaultMaxPriorityFeePerGas,
    maxFeePerGas: vaultMaxFeePerGas,
    gasLimit: vaultGasLimits.approve,
    to: stataUnderlying,                            // approve is called ON the underlying token
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<2>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };

  const path = pad(32, "vault");
  const schema = vaultResponseSchema();
  const requestNonce = vaultSignedRequestNonce();
  const request = constructSignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34>(
    kernel.self(), requestNonce, keyVersion, path,
    MPCSignatureAlgorithm.ecdsa, MPCDestination.unused, pad(64, ""),
    TxParamType.evmType2, txParams, caip2Id, schema, schema
  );
  const requestId = disclose(calculateRequestId<EvmType2TxParams<2, 0, 0>, 34, 34>(request));
  assert(!signBidirectionalEventMap.member(requestId), "Request already exists");
  signBidirectionalEventMap.insert(requestId, disclose(request));

  // Notify the MPC (signBidirectionalEventMap's compiled ledger path, [0,0]).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(), 2 as Uint<8>, [0, 0, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// Permissionless per-token router allowance, signed with the VAULT account. Spender
// and amount are contract-fixed, so the caller chooses ONLY the token.
export circuit approveRouter(
  erc20Address: Bytes<20>,
  keyVersion: Uint<8>
): [] {
  assert(initialised >= 1, "Not initialised");
  assert(erc20Address as Field != 0 as Field, "ERC20 address cannot be zero");

  // The vault account's nonce comes from the contract, never the caller: see
  // approveStata above and vaultEvmNonce.
  const evmNonce = vaultEvmNonce as Uint<64>;
  vaultEvmNonce.increment(1);

  const calldata = EvmCalldata<2> {
    selector: Bytes [0x09, 0x5e, 0xa7, 0xb3], // approve(address,uint256)
    noWords: 2 as Uint<16>,
    words: [
      evmAddressAbiWord(uniswapRouter),
      numericAbiWord(unlimitedAllowance()),
    ]
  };

  const txParams = EvmType2TxParams<2, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: vaultMaxPriorityFeePerGas,
    maxFeePerGas: vaultMaxFeePerGas,
    gasLimit: vaultGasLimits.approve,
    to: disclose(erc20Address),                    // approve is called ON the ERC20
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<2>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };

  const path = pad(32, "vault");
  const schema = vaultResponseSchema();
  const requestNonce = vaultSignedRequestNonce();
  const request = constructSignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34>(
    kernel.self(),
    requestNonce,
    keyVersion,
    path,
    MPCSignatureAlgorithm.ecdsa,
    MPCDestination.unused,
    pad(64, ""),
    TxParamType.evmType2,
    txParams,
    caip2Id,
    schema,
    schema
  );
  const requestId = disclose(calculateRequestId<EvmType2TxParams<2, 0, 0>, 34, 34>(request));
  assert(!signBidirectionalEventMap.member(requestId), "Request already exists");
  signBidirectionalEventMap.insert(requestId, disclose(request));

  // Notify the MPC (signBidirectionalEventMap's compiled ledger path, [0,0]).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(),
      2 as Uint<8>,
      [0, 0, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// ==== Deposit ========================================================================

struct DepositRequest {
  erc20Address: Bytes<20>; // the ERC20 token contract on the target chain
  amount: Uint<128>;       // token amount to move into the vault
}

// Records transfer(vaultEvmAddress, amount) on the ERC20, signed by the MPC with the
// CALLER's derived account (the path is the caller's commitment, recomputed in-circuit).
export circuit startDeposit(
  evmNonce: Uint<64>,
  gasLimit: Uint<64>,
  maxFeePerGas: Uint<128>,
  maxPriorityFeePerGas: Uint<128>,
  keyVersion: Uint<8>,
  depositRequest: DepositRequest
): [] {
  assert(initialised >= 1, "Not initialised");
  assert(depositRequest.erc20Address as Field != 0 as Field, "ERC20 address cannot be zero");
  assert(depositRequest.amount > 0 as Uint<128>, "Amount must be positive");
  // completeDeposit mints via a Uint<64> API, so reject unclaimable amounts.
  assert(depositRequest.amount <= 18446744073709551615 as Uint<128>, "Amount exceeds Uint<64> max");
  assert(gasLimit > 0 as Uint<64>, "Gas limit must be positive");

  const caller = disclose(userCommitment(callerSecretKey()));

  // The pinned recipient stops a client having the MPC sign a transfer to themselves.
  const calldata = EvmCalldata<2> {
    selector: Bytes [0xa9, 0x05, 0x9c, 0xbb], // transfer(address,uint256)
    noWords: 2 as Uint<16>,
    words: [
      evmAddressAbiWord(vaultEvmAddress),
      numericAbiWord(depositRequest.amount),
    ]
  };

  const txParams = EvmType2TxParams<2, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: maxPriorityFeePerGas,
    maxFeePerGas: maxFeePerGas,
    gasLimit: gasLimit,
    to: depositRequest.erc20Address,
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<2>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };

  const schema = vaultResponseSchema();
  // Per-caller nonce: read THIS caller's slot (default 0 for a first deposit),
  // never a shared cell, so a concurrent deposit by another caller reads a
  // different slot and does not conflict at apply time.
  //
  // Deposit needs a REAL counter, unlike the vault-signed flows. Its EVM nonce
  // comes from the CALLER's own derived account, not from vaultEvmNonce, so the
  // contract cannot lean on that nonce to separate two identical requests the
  // way vaultSignedRequestNonce() does: two callers can hold the same account
  // nonce on their own accounts. Here the path (the caller's commitment) and
  // this slot do that job.
  if (!depositRequestNonces.member(caller)) {
    depositRequestNonces.insertDefault(caller);
  }
  const requestNonce = depositRequestNonces.lookup(caller) as Uint<64>;
  const request = constructSignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34>(
    kernel.self(),
    requestNonce,
    keyVersion,
    caller,
    MPCSignatureAlgorithm.ecdsa,
    MPCDestination.unused,
    pad(64, ""),
    TxParamType.evmType2,
    txParams,
    caip2Id,
    schema,
    schema
  );
  const requestId = disclose(calculateRequestId<EvmType2TxParams<2, 0, 0>, 34, 34>(request));

  assert(!depositEventMap.member(requestId), "Request already exists");
  depositRequestNonces.lookup(caller).increment(1);
  depositEventMap.insert(requestId, disclose(request));
  depositSettleViews.insert(requestId, DepositSettleView {
    commitment: caller,
    erc20: disclose(depositRequest.erc20Address),
    amount: disclose(depositRequest.amount as Uint<64>),
  });

  // Notify the MPC (depositEventMap's compiled ledger path, [1,3]).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(),
      2 as Uint<8>,
      [1, 3, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// Settles a successful deposit: mints shielded vault tokens for the deposited amount.
// Depositor-gated, one settle per request. mintNonce must be caller-chosen RANDOM: one
// derived from the (public) requestId would link the minted coin to the deposit.
export circuit completeDeposit(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<1>,
  mintNonce: Bytes<32>,
  recipient: Maybe<Either<ZswapCoinPublicKey, ContractAddress>>,
): [] {
  const disclosedRequestId = disclose(requestId);

  assert(initialised >= 1, "Not initialised");

  const response = deserialize<VaultResponse, 1>(serializedOutput);
  assert(response.success, "ERC20 transfer returned false");

  // The only authentication gate: the attestation digest is recomputed from the
  // presented output and the signature must verify against mpcResponseKey.
  assert(
    verifyRespondBidirectionalEvent<1>(
      disclosedRequestId,
      serializedOutput,
      disclose(respondBidirectionalEvent),
      mpcResponseKey
    ),
    "Invalid attestation signature"
  );

  assert(depositEventMap.member(disclosedRequestId), "Deposit not found");
  depositEventMap.remove(disclosedRequestId);

  const view = depositSettleViews.lookup(disclosedRequestId);
  assert(userCommitment(callerSecretKey()) == view.commitment, "Not the depositor");
  depositSettleViews.remove(disclosedRequestId);

  const claimRecipient = disclose(recipient).is_some
    ? disclose(recipient).value
    : left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
  mintShieldedToken(
    vaultTokenDomainSeparator(view.erc20),
    view.amount,
    disclose(mintNonce),
    claimRecipient
  );
}

// ==== Withdraw =======================================================================

struct WithdrawRequest {
  erc20Address: Bytes<20>;   // the ERC20 token contract on the target chain
  amount: Uint<128>;         // token amount to pull out of the vault
  destEvmAddress: Bytes<20>; // EVM recipient of the vault's transfer
}

// Starts a withdrawal, optimistically: burns the surrendered vault coin up front and
// QUEUES transfer(destEvmAddress, amount) for `flush` to record and sign with the
// VAULT's own account. The coin spend IS the auth, and the vault pays the gas, so the
// fee envelope is contract-fixed (rebuilt verbatim by recordWithdraw).
//
// This circuit reads NO shared ledger cell: it appends under a key only this caller
// can compute, so two callers' withdrawals proven against the same state both apply.
// The request id, its event record and the MPC notification are `flush`'s job.
export circuit startWithdraw(
  keyVersion: Uint<8>,
  withdrawRequest: WithdrawRequest,
  coin: ShieldedCoinInfo
): [] {
  assert(initialised >= 1, "Not initialised");
  assert(withdrawRequest.erc20Address as Field != 0 as Field, "ERC20 address cannot be zero");
  assert(withdrawRequest.amount > 0 as Uint<128>, "Amount must be positive");

  // refundWithdraw re-mints via stdlib mintShieldedToken, which takes a Uint<64> amount.
  assert(withdrawRequest.amount <= 18446744073709551615 as Uint<128>, "Amount exceeds Uint<64> max");

  // Checked HERE even though only flush constructs the event: the same assert
  // inside constructSignBidirectionalEvent would fire at flush time, on an entry
  // whose coin is already burned and which no flush could ever drain.
  assert(keyVersion >= 1, "keyVersion must be >= 1");

  const color = tokenType(
    vaultTokenDomainSeparator(disclose(withdrawRequest.erc20Address)),
    kernel.self()
  );
  assert(coin.color == color, "Coin is not the vault token for this ERC20");
  assert(coin.value == withdrawRequest.amount, "Coin value must equal the withdraw amount");

  // The queue key, and the refund commitment flush pins into the settle view:
  // this caller's secret bound to the surrendered coin's nonce.
  const requestKey = disclose(refundCommitment(callerSecretKey(), coin.nonce));
  assert(!pendingVaultRequests.member(requestKey), "Request already queued");

  // receiveShielded makes the coin the contract's, so the burn send can spend it.
  receiveShielded(disclose(coin));
  sendImmediateShielded(disclose(coin), shieldedBurnAddress(), disclose(coin).value);

  pendingVaultRequests.insert(requestKey, disclose(PendingVaultRequest {
    kind: PendingRequestKind.withdraw,
    keyVersion: keyVersion,
    tokenA: withdrawRequest.erc20Address,
    tokenB: withdrawRequest.destEvmAddress,
    fee: 0 as Uint<24>,
    amountA: withdrawRequest.amount,
    amountB: 0 as Uint<128>,
    coinNonce: coin.nonce,
  }));
}

// Settles an EXECUTED withdrawal in both branches, decided by the attested 1-byte
// bool, never the caller: on success only cleanup (anyone may settle it), on a false
// return a withdrawer-only re-mint. One settle per request.
export circuit completeWithdraw(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<1>,
  mintNonce: Bytes<32>,
): [] {
  const disclosedRequestId = disclose(requestId);

  assert(initialised >= 1, "Not initialised");

  assert(
    verifyRespondBidirectionalEvent<1>(
      disclosedRequestId,
      serializedOutput,
      disclose(respondBidirectionalEvent),
      mpcResponseKey
    ),
    "Invalid attestation signature"
  );

  // Deposits never insert withdrawSettleViews, so a deposit cannot be settled here.
  assert(withdrawSettleViews.member(disclosedRequestId), "Withdrawal not found");
  const view = withdrawSettleViews.lookup(disclosedRequestId);
  signBidirectionalEventMap.remove(disclosedRequestId);

  const succeeded = disclose(deserialize<VaultResponse, 1>(serializedOutput).success);
  const domainSep = vaultTokenDomainSeparator(view.erc20);

  // The transfer can fail by the ERC20 returning false even when the transaction succeeds.
  // The withdrawer's secret is witnessed only on this branch: a succeeded withdrawal is
  // settleable by anyone and must not require (or consume) a secret to settle.
  if (!succeeded) {
    // The settle view's commitment is bound to the SURRENDERED COIN's nonce,
    // not to the request id: startWithdraw pinned it before flush minted an id.
    const myCommitment = refundCommitment(callerSecretKey(), view.coinNonce);
    assert(myCommitment == view.commitment, "Not the withdrawer");
    const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
    mintShieldedToken(domainSep, view.amount, disclose(mintNonce), recipient);
  }

  withdrawSettleViews.remove(disclosedRequestId);
}

// Withdrawer-only re-mint of the surrendered amount when the transfer never executed.
export circuit refundWithdraw(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<5>,
  mintNonce: Bytes<32>,
): [] {
  const disclosedRequestId = disclose(requestId);
  assertAttestedFailureOutput(disclosedRequestId, respondBidirectionalEvent, serializedOutput);

  assert(withdrawSettleViews.member(disclosedRequestId), "Withdrawal not found");
  const view = withdrawSettleViews.lookup(disclosedRequestId);
  assert(
    refundCommitment(callerSecretKey(), view.coinNonce) == view.commitment,
    "Not the withdrawer"
  );
  signBidirectionalEventMap.remove(disclosedRequestId);
  withdrawSettleViews.remove(disclosedRequestId);

  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
  mintShieldedToken(vaultTokenDomainSeparator(view.erc20), view.amount, disclose(mintNonce), recipient);
}

// ==== Swap (Uniswap V3) ==============================================================

// The MPC decodes the uint256 return (outputSchema), then attests it packed as uint64.
export pure circuit swapOutputSchema(): Bytes<38> {
  return "[{\"name\":\"amountIn\",\"type\":\"uint256\"}]" as Bytes<38>;
}
export pure circuit swapRespondSchema(): Bytes<37> {
  return "[{\"name\":\"amountIn\",\"type\":\"uint64\"}]" as Bytes<37>;
}

struct SwapRequest {
  tokenIn: Bytes<20>;          // ERC20 sold (its vault coin is surrendered)
  tokenOut: Bytes<20>;         // ERC20 bought (its vault coin is minted on success)
  fee: Uint<24>;               // Uniswap V3 pool fee tier (e.g. 500, 3000)
  amountOut: Uint<128>;        // exact output amount to receive
  amountInMaximum: Uint<128>;  // max input to spend (slippage cap; router reverts above it)
}

// Starts a swap, optimistically: burns the surrendered amountInMaximum of tokenIn and
// QUEUES exactOutputSingle on the pinned router for `flush` to record and sign with the
// VAULT's account. exactOutput (not exactInput) so the mint amount is known and bounded
// BEFORE the burn: an oversized swap result would strand the already-burned coin.
// Reads no shared ledger cell; see pendingVaultRequests and startWithdraw.
export circuit startSwap(
  keyVersion: Uint<8>,
  swapRequest: SwapRequest,
  coin: ShieldedCoinInfo
): [] {
  assert(initialised >= 1, "Not initialised");
  assert(swapRequest.tokenIn as Field != 0 as Field, "tokenIn cannot be zero");
  assert(swapRequest.tokenOut as Field != 0 as Field, "tokenOut cannot be zero");
  assert(swapRequest.amountOut > 0 as Uint<128>, "amountOut must be positive");
  assert(swapRequest.amountInMaximum > 0 as Uint<128>, "amountInMaximum must be positive");
  // Every later mint uses the Uint<64> mint API, so bound both here, BEFORE the burn.
  assert(swapRequest.amountOut <= 18446744073709551615 as Uint<128>, "amountOut exceeds Uint<64> max");
  assert(swapRequest.amountInMaximum <= 18446744073709551615 as Uint<128>, "amountInMaximum exceeds Uint<64> max");
  // Checked here, not at flush: an entry flush cannot construct would strand the burn.
  assert(keyVersion >= 1, "keyVersion must be >= 1");

  const color = tokenType(
    vaultTokenDomainSeparator(disclose(swapRequest.tokenIn)),
    kernel.self()
  );
  assert(coin.color == color, "Coin is not the vault token for tokenIn");
  assert(coin.value == swapRequest.amountInMaximum, "Coin value must equal amountInMaximum");

  const requestKey = disclose(refundCommitment(callerSecretKey(), coin.nonce));
  assert(!pendingVaultRequests.member(requestKey), "Request already queued");

  receiveShielded(disclose(coin));
  sendImmediateShielded(disclose(coin), shieldedBurnAddress(), disclose(coin).value);

  pendingVaultRequests.insert(requestKey, disclose(PendingVaultRequest {
    kind: PendingRequestKind.swap,
    keyVersion: keyVersion,
    tokenA: swapRequest.tokenIn,
    tokenB: swapRequest.tokenOut,
    fee: swapRequest.fee,
    amountA: swapRequest.amountOut,
    amountB: swapRequest.amountInMaximum,
    coinNonce: coin.nonce,
  }));
}

// swapRespondSchema()'s output decoded: the amountIn the swap spent, packed to 8 bytes.
struct ExactOutputSingleReturnValue {
  amountIn: Uint<64>;
}

// Settles a SUCCESSFUL swap: mints the exact amountOut of tokenOut plus the unspent
// tokenIn as change. Swapper-gated, one settle per request. A swap whose transaction
// never executed settles through refundSwap.
export circuit completeSwap(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<8>,
  mintNonce: Bytes<32>,
  changeNonce: Bytes<32>,
): [] {
  const disclosedRequestId = disclose(requestId);

  assert(initialised >= 1, "Not initialised");
  // The two mints need distinct nonces or their coins link, so changeNonce must carry
  // its own entropy, never derived from mintNonce.
  assert(changeNonce != mintNonce, "changeNonce must differ from mintNonce");

  assert(
    verifyRespondBidirectionalEvent<8>(
      disclosedRequestId,
      serializedOutput,
      disclose(respondBidirectionalEvent),
      mpcResponseKey
    ),
    "Invalid attestation signature"
  );

  assert(swapSettleViews.member(disclosedRequestId), "Swap not found");
  const view = swapSettleViews.lookup(disclosedRequestId);
  swapEventMap.remove(disclosedRequestId);

  assert(
    refundCommitment(callerSecretKey(), view.coinNonce) == view.commitment,
    "Not the swapper"
  );
  swapSettleViews.remove(disclosedRequestId);

  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());

  mintShieldedToken(vaultTokenDomainSeparator(view.tokenOut), view.amountOut, disclose(mintNonce), recipient);

  // change <= amountInMaximum, so it fits Uint<64>. An exact spend mints a 0-value coin.
  const amountIn = disclose(deserialize<ExactOutputSingleReturnValue, 8>(serializedOutput).amountIn);
  const change = view.amountInMaximum - amountIn;
  mintShieldedToken(vaultTokenDomainSeparator(view.tokenIn), change as Uint<64>, disclose(changeNonce), recipient);
}

// Swapper-only re-mint of the full amountInMaximum when the swap never executed.
export circuit refundSwap(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<5>,
  mintNonce: Bytes<32>,
): [] {
  const disclosedRequestId = disclose(requestId);
  assertAttestedFailureOutput(disclosedRequestId, respondBidirectionalEvent, serializedOutput);

  assert(swapSettleViews.member(disclosedRequestId), "Swap not found");
  const view = swapSettleViews.lookup(disclosedRequestId);
  assert(
    refundCommitment(callerSecretKey(), view.coinNonce) == view.commitment,
    "Not the swapper"
  );
  swapEventMap.remove(disclosedRequestId);
  swapSettleViews.remove(disclosedRequestId);

  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
  mintShieldedToken(vaultTokenDomainSeparator(view.tokenIn), view.amountInMaximum, disclose(mintNonce), recipient);
}

// ==== Supply (Aave, via the stataUSDC wrapper) =======================================

export pure circuit supplyOutputSchema(): Bytes<36> {
  return "[{\"name\":\"shares\",\"type\":\"uint256\"}]" as Bytes<36>;
}
export pure circuit supplyRespondSchema(): Bytes<35> {
  return "[{\"name\":\"shares\",\"type\":\"uint64\"}]" as Bytes<35>;
}

// Burns the surrendered USDC vault coin and QUEUES stataToken.deposit(amount, vault) for
// `flush` to record and have signed by the VAULT account (exact-input, so no change).
// Reads no shared ledger cell; see pendingVaultRequests and startWithdraw.
export circuit startSupply(
  keyVersion: Uint<8>,
  amount: Uint<128>,
  coin: ShieldedCoinInfo
): [] {
  assert(initialised >= 1, "Not initialised");
  assert(amount > 0 as Uint<128>, "amount must be positive");
  // refundSupply re-mints via the Uint<64> mint API, so reject unrefundable amounts.
  assert(amount <= 18446744073709551615 as Uint<128>, "amount exceeds Uint<64> max");
  // Checked here, not at flush: an entry flush cannot construct would strand the burn.
  assert(keyVersion >= 1, "keyVersion must be >= 1");

  const color = tokenType(vaultTokenDomainSeparator(stataUnderlying), kernel.self());
  assert(coin.color == color, "Coin is not the vault token for the underlying");
  assert(coin.value == amount, "Coin value must equal amount");

  const requestKey = disclose(refundCommitment(callerSecretKey(), coin.nonce));
  assert(!pendingVaultRequests.member(requestKey), "Request already queued");

  receiveShielded(disclose(coin));
  sendImmediateShielded(disclose(coin), shieldedBurnAddress(), disclose(coin).value);

  pendingVaultRequests.insert(requestKey, disclose(PendingVaultRequest {
    kind: PendingRequestKind.supply,
    keyVersion: keyVersion,
    tokenA: stataUnderlying,
    tokenB: stataToken,
    fee: 0 as Uint<24>,
    amountA: amount,
    amountB: 0 as Uint<128>,
    coinNonce: coin.nonce,
  }));
}

// supplyRespondSchema()'s output decoded, packed by the MPC to 8 bytes.
struct DepositReturnValue {
  shares: Uint<64>;
}

// Settles a successful supply: mints shielded(stataToken) for the attested shares.
// Supplier-gated, one settle per request.
export circuit completeSupply(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<8>,
  mintNonce: Bytes<32>,
): [] {
  const disclosedRequestId = disclose(requestId);
  assert(initialised >= 1, "Not initialised");
  assert(
    verifyRespondBidirectionalEvent<8>(
      disclosedRequestId, serializedOutput, disclose(respondBidirectionalEvent), mpcResponseKey
    ),
    "Invalid attestation signature"
  );

  assert(supplyEventMap.member(disclosedRequestId), "Supply not found");
  supplyEventMap.remove(disclosedRequestId);
  const supplyView = supplySettleViews.lookup(disclosedRequestId);
  assert(
    refundCommitment(callerSecretKey(), supplyView.coinNonce) == supplyView.commitment,
    "Not the supplier"
  );
  supplySettleViews.remove(disclosedRequestId);

  const shares = disclose(deserialize<DepositReturnValue, 8>(serializedOutput).shares);
  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
  mintShieldedToken(vaultTokenDomainSeparator(stataToken), shares, disclose(mintNonce), recipient);
}

// Supplier-only re-mint of the surrendered amount when the deposit never executed.
export circuit refundSupply(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<5>,
  mintNonce: Bytes<32>,
): [] {
  const disclosedRequestId = disclose(requestId);
  assertAttestedFailureOutput(disclosedRequestId, respondBidirectionalEvent, serializedOutput);

  assert(supplySettleViews.member(disclosedRequestId), "Supply not found");
  const view = supplySettleViews.lookup(disclosedRequestId);
  assert(
    refundCommitment(callerSecretKey(), view.coinNonce) == view.commitment,
    "Not the supplier"
  );
  supplyEventMap.remove(disclosedRequestId);
  supplySettleViews.remove(disclosedRequestId);

  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
  mintShieldedToken(vaultTokenDomainSeparator(stataUnderlying), view.amount, disclose(mintNonce), recipient);
}

// ==== Redeem (Aave, via the stataUSDC wrapper) =======================================

export pure circuit redeemOutputSchema(): Bytes<36> {
  return "[{\"name\":\"assets\",\"type\":\"uint256\"}]" as Bytes<36>;
}
export pure circuit redeemRespondSchema(): Bytes<35> {
  return "[{\"name\":\"assets\",\"type\":\"uint64\"}]" as Bytes<35>;
}

// Burns the surrendered stataToken vault coin and QUEUES stataToken.redeem(shares,
// vault, vault) for `flush` to record and have signed by the VAULT account.
// Reads no shared ledger cell; see pendingVaultRequests and startWithdraw.
export circuit startRedeem(
  keyVersion: Uint<8>,
  shares: Uint<128>,
  coin: ShieldedCoinInfo
): [] {
  assert(initialised >= 1, "Not initialised");
  assert(shares > 0 as Uint<128>, "shares must be positive");
  // CAUTION: this bounds `shares`, not the assets that come back. Aave's exchange rate
  // only grows, so assets >= shares, and completeRedeem mints assets through the same
  // Uint<64> API after the coin is already burned. Fine for USDC. An 18-decimal
  // underlying caps the whole vault near 18.4 tokens. See #43 before lending anything
  // but USDC.
  assert(shares <= 18446744073709551615 as Uint<128>, "shares exceeds Uint<64> max");
  // Checked here, not at flush: an entry flush cannot construct would strand the burn.
  assert(keyVersion >= 1, "keyVersion must be >= 1");

  const color = tokenType(vaultTokenDomainSeparator(stataToken), kernel.self());
  assert(coin.color == color, "Coin is not the vault token for the wrapper");
  assert(coin.value == shares, "Coin value must equal shares");

  const requestKey = disclose(refundCommitment(callerSecretKey(), coin.nonce));
  assert(!pendingVaultRequests.member(requestKey), "Request already queued");

  receiveShielded(disclose(coin));
  sendImmediateShielded(disclose(coin), shieldedBurnAddress(), disclose(coin).value);

  pendingVaultRequests.insert(requestKey, disclose(PendingVaultRequest {
    kind: PendingRequestKind.redeem,
    keyVersion: keyVersion,
    tokenA: stataToken,
    tokenB: stataUnderlying,
    fee: 0 as Uint<24>,
    amountA: shares,
    amountB: 0 as Uint<128>,
    coinNonce: coin.nonce,
  }));
}

// redeemRespondSchema()'s output decoded, packed by the MPC to 8 bytes.
struct RedeemReturnValue {
  assets: Uint<64>;
}

// Settles a successful redeem: mints shielded(stataUnderlying) for the attested assets
// (principal + accrued interest). Redeemer-gated, one settle per request.
export circuit completeRedeem(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<8>,
  mintNonce: Bytes<32>,
): [] {
  const disclosedRequestId = disclose(requestId);
  assert(initialised >= 1, "Not initialised");
  assert(
    verifyRespondBidirectionalEvent<8>(
      disclosedRequestId, serializedOutput, disclose(respondBidirectionalEvent), mpcResponseKey
    ),
    "Invalid attestation signature"
  );

  assert(redeemEventMap.member(disclosedRequestId), "Redeem not found");
  redeemEventMap.remove(disclosedRequestId);
  const redeemView = redeemSettleViews.lookup(disclosedRequestId);
  assert(
    refundCommitment(callerSecretKey(), redeemView.coinNonce) == redeemView.commitment,
    "Not the redeemer"
  );
  redeemSettleViews.remove(disclosedRequestId);

  const assets = disclose(deserialize<RedeemReturnValue, 8>(serializedOutput).assets);
  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
  mintShieldedToken(vaultTokenDomainSeparator(stataUnderlying), assets, disclose(mintNonce), recipient);
}

// Redeemer-only re-mint of the surrendered shares when the redeem never executed.
export circuit refundRedeem(
  requestId: RequestId,
  respondBidirectionalEvent: RespondBidirectionalEvent,
  serializedOutput: Bytes<5>,
  mintNonce: Bytes<32>,
): [] {
  const disclosedRequestId = disclose(requestId);
  assertAttestedFailureOutput(disclosedRequestId, respondBidirectionalEvent, serializedOutput);

  assert(redeemSettleViews.member(disclosedRequestId), "Redeem not found");
  const view = redeemSettleViews.lookup(disclosedRequestId);
  assert(
    refundCommitment(callerSecretKey(), view.coinNonce) == view.commitment,
    "Not the redeemer"
  );
  redeemEventMap.remove(disclosedRequestId);
  redeemSettleViews.remove(disclosedRequestId);

  const recipient = left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey());
  mintShieldedToken(vaultTokenDomainSeparator(stataToken), view.shares, disclose(mintNonce), recipient);
}

// ==== Flush: the batched drain of pendingVaultRequests ===============================
//
// FOUR entry points — flushWithdraws, flushSwaps, flushSupplies, flushRedeems —
// each callable by ANYONE (a user, a relayer, the MPC's own tooling), that turn
// queued vault-signed requests into recorded SignBidirectionalEvents. One per
// KIND, because a circuit contains every branch it might take: a single drain
// with a four-way dispatch charges every flusher for all four transaction
// builders in every slot, and that cost is what bounds the batch width. Each
// entry point drains only its own kind and skips the rest.
//
// They are the ONLY place the four vault-signed flows touch vaultEvmNonce, and
// each hands the entry it drains the next value of it.
//
// ONE counter, doing BOTH jobs. vaultEvmNonce is the shared vault EVM account's
// transaction nonce, so it must be CONTIGUOUS: Ethereum executes an account's
// transactions in nonce order and one skipped value stalls every later vault
// transaction. It is therefore consumed inside the live branch, one per entry
// actually DRAINED, and a skipped slot advances it by nothing.
//
// That same nonce is also what keeps two otherwise identical requests hashing
// to DISTINCT ids: it sits in the request's txParams, which the id hashes, and
// one account spends each of its nonces once. So `requestNonce` is the
// constant vaultSignedRequestNonce() here, and there is no second counter to
// assign. See signetRequestNonce, kept only for its pinned ledger path.
//
// BOUND: a FIXED number of entries per call, named by key. Compact has no
// unbounded iteration and no way to enumerate a ledger Map, so a drain must be an
// unrolled loop over caller-supplied keys. The width is declared exactly once,
// on the four adjacent wrappers at the bottom of this file. A slot whose key is
// not queued, or whose entry belongs to another kind, is skipped — so a batch of
// one is a valid call; a key repeated inside one batch is processed once (the
// first slot removes it, the rest see it gone).
//
// KNOWN LIMITS, stated plainly:
//  - Concurrent flushes still conflict with each other and with approveStata /
//    approveRouter, which read the same counter. Serialising the BATCHES is
//    the whole point; what had to stop serialising was users' start* calls.
//    approveStata/approveRouter had to move onto vaultEvmNonce too: they sign
//    from the SAME vault account, so a caller-chosen nonce there would collide
//    with (or leave a gap ahead of) the values the drains hand out. The four
//    entry points also conflict with EACH OTHER, since all four touch that one
//    counter; splitting by kind buys proof size, not concurrency.
//  - The flusher chooses the batch and its order, so it chooses the order request
//    ids are minted in. It cannot forge, alter, drop or steal an entry: every
//    field comes from the queue and the settle view keeps the requester's own
//    commitment.
//  - A queued entry is inert until someone flushes it, and the requester's coin is
//    already burned by then, so an entry nobody flushes is refundable by nobody.
//    A client should flush its own request rather than trust a relayer to.
//  - A batch is homogeneous by construction: a caller with a mixed set of keys
//    calls more than one entry point, and pays for each separately.

// Records a queued withdraw as a signBidirectionalEventMap event under the
// batch-assigned nonce, pins the settle view and notifies the MPC.
circuit recordWithdraw(
  key: Bytes<32>,
  pending: PendingVaultRequest,
  requestNonce: Uint<64>,
  evmNonce: Uint<64>
): [] {
  const calldata = EvmCalldata<2> {
    selector: Bytes [0xa9, 0x05, 0x9c, 0xbb], // transfer(address,uint256)
    noWords: 2 as Uint<16>,
    words: [
      evmAddressAbiWord(pending.tokenB), // destEvmAddress
      numericAbiWord(pending.amountA),   // amount
    ]
  };
  const txParams = EvmType2TxParams<2, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: vaultMaxPriorityFeePerGas,
    maxFeePerGas: vaultMaxFeePerGas,
    gasLimit: vaultGasLimits.withdraw,
    to: pending.tokenA,                            // the ERC20
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<2>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };
  const schema = vaultResponseSchema();
  const request = constructSignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 34, 34>(
    kernel.self(),
    requestNonce,
    pending.keyVersion,
    pad(32, "vault"),
    MPCSignatureAlgorithm.ecdsa,
    MPCDestination.unused,
    pad(64, ""),
    TxParamType.evmType2,
    txParams,
    caip2Id,
    schema,
    schema
  );
  const requestId = calculateRequestId<EvmType2TxParams<2, 0, 0>, 34, 34>(request);
  assert(!signBidirectionalEventMap.member(requestId), "Request already exists");
  signBidirectionalEventMap.insert(requestId, request);
  // The queue key IS the requester's refund commitment (see pendingVaultRequests),
  // so flush pins the ownership gate without ever seeing a secret.
  withdrawSettleViews.insert(requestId, WithdrawSettleView {
    commitment: key,
    coinNonce: pending.coinNonce,
    erc20: pending.tokenA,
    amount: pending.amountA as Uint<64>,
  });
  pendingVaultRequests.remove(key);

  // Notify the MPC (signBidirectionalEventMap's compiled ledger path, [0,0]).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(),
      2 as Uint<8>,
      [0, 0, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// Records a queued swap on the pinned router. Same shape as recordWithdraw.
circuit recordSwap(
  key: Bytes<32>,
  pending: PendingVaultRequest,
  requestNonce: Uint<64>,
  evmNonce: Uint<64>
): [] {
  const calldata = EvmCalldata<7> {
    selector: Bytes [0x50, 0x23, 0xb4, 0xdf], // exactOutputSingle((address,address,uint24,address,uint256,uint256,uint160))
    noWords: 7 as Uint<16>,
    words: [
      evmAddressAbiWord(pending.tokenA),           // tokenIn
      evmAddressAbiWord(pending.tokenB),           // tokenOut
      numericAbiWord(pending.fee as Uint<128>),
      evmAddressAbiWord(vaultEvmAddress),          // recipient: bought tokens return to the pool
      numericAbiWord(pending.amountA),             // amountOut
      numericAbiWord(pending.amountB),             // amountInMaximum
      numericAbiWord(0 as Uint<128>),              // sqrtPriceLimitX96
    ]
  };
  const txParams = EvmType2TxParams<7, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: vaultMaxPriorityFeePerGas,
    maxFeePerGas: vaultMaxFeePerGas,
    gasLimit: vaultGasLimits.swap,
    to: uniswapRouter,
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<7>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };
  const request = constructSignBidirectionalEvent<EvmType2TxParams<7, 0, 0>, 38, 37>(
    kernel.self(),
    requestNonce,
    pending.keyVersion,
    pad(32, "vault"),
    MPCSignatureAlgorithm.ecdsa,
    MPCDestination.unused,
    pad(64, ""),
    TxParamType.evmType2,
    txParams,
    caip2Id,
    swapOutputSchema(),
    swapRespondSchema()
  );
  const requestId = calculateRequestId<EvmType2TxParams<7, 0, 0>, 38, 37>(request);
  assert(!swapEventMap.member(requestId), "Request already exists");
  swapEventMap.insert(requestId, request);
  swapSettleViews.insert(requestId, SwapSettleView {
    commitment: key,
    coinNonce: pending.coinNonce,
    tokenIn: pending.tokenA,
    tokenOut: pending.tokenB,
    amountOut: pending.amountA as Uint<64>,
    amountInMaximum: pending.amountB as Uint<64>,
  });
  pendingVaultRequests.remove(key);

  // Notify the MPC (swapEventMap's compiled ledger path, [1,7]).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(),
      2 as Uint<8>,
      [1, 7, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// Records a queued supply: stataToken.deposit(amount, vault).
circuit recordSupply(
  key: Bytes<32>,
  pending: PendingVaultRequest,
  requestNonce: Uint<64>,
  evmNonce: Uint<64>
): [] {
  const calldata = EvmCalldata<2> {
    selector: Bytes [0x6e, 0x55, 0x3f, 0x65], // deposit(uint256,address)
    noWords: 2 as Uint<16>,
    words: [
      numericAbiWord(pending.amountA),
      evmAddressAbiWord(vaultEvmAddress),
    ]
  };
  const txParams = EvmType2TxParams<2, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: vaultMaxPriorityFeePerGas,
    maxFeePerGas: vaultMaxFeePerGas,
    gasLimit: vaultGasLimits.supply,
    to: pending.tokenB,             // the stataToken wrapper
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<2>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };
  const request = constructSignBidirectionalEvent<EvmType2TxParams<2, 0, 0>, 36, 35>(
    kernel.self(), requestNonce, pending.keyVersion, pad(32, "vault"),
    MPCSignatureAlgorithm.ecdsa, MPCDestination.unused, pad(64, ""),
    TxParamType.evmType2, txParams, caip2Id, supplyOutputSchema(), supplyRespondSchema()
  );
  const requestId = calculateRequestId<EvmType2TxParams<2, 0, 0>, 36, 35>(request);
  assert(!supplyEventMap.member(requestId), "Request already exists");
  supplyEventMap.insert(requestId, request);
  supplySettleViews.insert(requestId, SupplySettleView {
    commitment: key,
    coinNonce: pending.coinNonce,
    amount: pending.amountA as Uint<64>,
  });
  pendingVaultRequests.remove(key);

  // Notify the MPC (supplyEventMap's compiled ledger path, [1,11]).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(), 2 as Uint<8>, [1, 11, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// Records a queued redeem: stataToken.redeem(shares, vault, vault).
circuit recordRedeem(
  key: Bytes<32>,
  pending: PendingVaultRequest,
  requestNonce: Uint<64>,
  evmNonce: Uint<64>
): [] {
  const calldata = EvmCalldata<3> {
    selector: Bytes [0xba, 0x08, 0x76, 0x52], // redeem(uint256,address,address)
    noWords: 3 as Uint<16>,
    words: [
      numericAbiWord(pending.amountA),    // shares
      evmAddressAbiWord(vaultEvmAddress),
      evmAddressAbiWord(vaultEvmAddress),
    ]
  };
  const txParams = EvmType2TxParams<3, 0, 0> {
    chainId: evmChainId,
    nonce: evmNonce,
    maxPriorityFeePerGas: vaultMaxPriorityFeePerGas,
    maxFeePerGas: vaultMaxFeePerGas,
    gasLimit: vaultGasLimits.redeem,
    to: pending.tokenA,             // the stataToken wrapper
    value: 0 as Uint<128>,
    calldata: some<EvmCalldata<3>>(calldata),
    accessListEntryCount: 0,
    accessList: []
  };
  const request = constructSignBidirectionalEvent<EvmType2TxParams<3, 0, 0>, 36, 35>(
    kernel.self(), requestNonce, pending.keyVersion, pad(32, "vault"),
    MPCSignatureAlgorithm.ecdsa, MPCDestination.unused, pad(64, ""),
    TxParamType.evmType2, txParams, caip2Id, redeemOutputSchema(), redeemRespondSchema()
  );
  const requestId = calculateRequestId<EvmType2TxParams<3, 0, 0>, 36, 35>(request);
  assert(!redeemEventMap.member(requestId), "Request already exists");
  redeemEventMap.insert(requestId, request);
  redeemSettleViews.insert(requestId, RedeemSettleView {
    commitment: key,
    coinNonce: pending.coinNonce,
    shares: pending.amountA as Uint<64>,
  });
  pendingVaultRequests.remove(key);

  // Notify the MPC (redeemEventMap's compiled ledger path, [1,13]).
  signetSigner.signBidirectional(
    requestId,
    constructSignBidirectionalEventNotificationV1(
      kernel.self(), 2 as Uint<8>, [1, 13, 0, 0] as Vector<4, Uint<8>>,
    ),
  );
}

// ==== The four per-kind drains =====================================================
//
// One drain per request kind, NOT one drain with a four-way dispatch. A circuit
// physically contains every branch it might take, so a single dispatching drain
// makes every flusher prove all four transaction builders in every slot —
// roughly 1,580 instructions per slot against 347 for withdraw alone. Splitting
// by kind means a caller proves only the arm it actually uses.
//
// The four are otherwise identical, and identical to each other on purpose:
// same key handling, same counter rule, same skip behaviour. Compact
// cannot abstract over which record* circuit a drain calls, so the shape is
// written out four times rather than hidden.
//
// An entry of ANOTHER kind is skipped exactly as a missing key is, consuming no
// EVM nonce and staying queued for the entry point that does own it.
//
// Permissionless: nothing here reads a secret, and every field of every request
// comes from the queue the requester filled in.
circuit drainWithdraws<#N>(keys: Vector<N, Bytes<32>>): [] {
  assert(initialised >= 1, "Not initialised");

  for (const slot of 0..N) {
    const key = disclose(keys[slot]);
    if (pendingVaultRequests.member(key)) {
      const pending = pendingVaultRequests.lookup(key);
      if (pending.kind == PendingRequestKind.withdraw) {
        // The ONE counter, read and consumed INSIDE the live branch, one value
        // per entry actually drained, so a batch hands out contiguous values
        // (see vaultEvmNonce). A slot that is empty OR of another kind consumes
        // nothing: a gap here would stall every later vault transaction behind
        // it.
        //
        // It is also all the uniqueness a request id needs. The nonce is in
        // txParams, so two byte-identical withdrawals drained by the same call
        // still hash to different ids, and `requestNonce` can be a constant.
        const evmNonce = vaultEvmNonce as Uint<64>;
        vaultEvmNonce.increment(1);
        recordWithdraw(key, pending, vaultSignedRequestNonce(), evmNonce);
      }
    }
  }
}

// The swap drain. Same shape and same counter rule as drainWithdraws.
circuit drainSwaps<#N>(keys: Vector<N, Bytes<32>>): [] {
  assert(initialised >= 1, "Not initialised");
  for (const slot of 0..N) {
    const key = disclose(keys[slot]);
    if (pendingVaultRequests.member(key)) {
      const pending = pendingVaultRequests.lookup(key);
      if (pending.kind == PendingRequestKind.swap) {
        const evmNonce = vaultEvmNonce as Uint<64>;
        vaultEvmNonce.increment(1);
        recordSwap(key, pending, vaultSignedRequestNonce(), evmNonce);
      }
    }
  }
}

// The supply drain. Same shape and same counter rule as drainWithdraws.
circuit drainSupplies<#N>(keys: Vector<N, Bytes<32>>): [] {
  assert(initialised >= 1, "Not initialised");
  for (const slot of 0..N) {
    const key = disclose(keys[slot]);
    if (pendingVaultRequests.member(key)) {
      const pending = pendingVaultRequests.lookup(key);
      if (pending.kind == PendingRequestKind.supply) {
        const evmNonce = vaultEvmNonce as Uint<64>;
        vaultEvmNonce.increment(1);
        recordSupply(key, pending, vaultSignedRequestNonce(), evmNonce);
      }
    }
  }
}

// The redeem drain. Same shape and same counter rule as drainWithdraws.
circuit drainRedeems<#N>(keys: Vector<N, Bytes<32>>): [] {
  assert(initialised >= 1, "Not initialised");
  for (const slot of 0..N) {
    const key = disclose(keys[slot]);
    if (pendingVaultRequests.member(key)) {
      const pending = pendingVaultRequests.lookup(key);
      if (pending.kind == PendingRequestKind.redeem) {
        const evmNonce = vaultEvmNonce as Uint<64>;
        vaultEvmNonce.increment(1);
        recordRedeem(key, pending, vaultSignedRequestNonce(), evmNonce);
      }
    }
  }
}

// ==== THE BATCH WIDTH ================================================================
//
// The four exported entry points, kept ADJACENT because the 5 in them is the
// SINGLE PLACE the flush batch width is defined. All four carry the same width
// and MUST be changed together: a caller pads every batch to exactly this many
// keys, and the flow layer holds one mirror of the number for all four.
//
// Changing it is NOT a hot config change. The width is baked into each circuit
// and therefore into its proving key, so a new width needs a RECOMPILE
// (`yarn compile:zk`) and a REDEPLOY; existing deployments keep the width they
// were compiled with. Cost grows per slot and differs per kind (swap is the
// dearest by some margin), so raise it against measured proving cost, not by
// feel.
//
// A slot whose key is not queued, or whose entry is of another kind, is skipped
// — so a batch of one is a valid call (pad the rest with a key nothing is queued
// under), and a key repeated inside one batch is processed once, because the
// first slot removes it and the rest see it gone.
export circuit flushWithdraws(keys: Vector<5, Bytes<32>>): [] { drainWithdraws<5>(keys); }
export circuit flushSwaps(keys: Vector<5, Bytes<32>>): [] { drainSwaps<5>(keys); }
export circuit flushSupplies(keys: Vector<5, Bytes<32>>): [] { drainSupplies<5>(keys); }
export circuit flushRedeems(keys: Vector<5, Bytes<32>>): [] { drainRedeems<5>(keys); }
