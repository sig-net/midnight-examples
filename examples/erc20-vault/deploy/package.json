{
  "name": "@sig-net/midnight-examples-erc20-vault-deploy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The ERC20 vault's deploy flows (the split base deploy plus per-circuit maintenance adds, and the deployer-gated initialise), their entrypoint environment, and the Node pieces those flows and the integration tests share: the compiled-contract binding over the contract package's managed/ output and the midnight-js provider set. Typed functions taking an env map, so the CLI entrypoints and the e2e setup run exactly the same code.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "deploy": "tsx scripts/deploy.ts",
    "deploy-initialise": "tsx scripts/deploy-initialise.ts",
    "initialise": "tsx scripts/initialise.ts",
    "record-contract-address": "tsx scripts/record-contract-address.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js": "5.0.0-beta.6",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-beta.6",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0-beta.6",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0-beta.6",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@sig-net/midnight": "0.21.0-rc.6",
    "@sig-net/midnight-contract": "0.21.0-rc.6",
    "@sig-net/midnight-contract-deploy": "0.21.0-rc.6",
    "@sig-net/midnight-examples-erc20-vault-contract": "*",
    "@sig-net/midnight-examples-lib": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
